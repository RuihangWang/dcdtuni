  "name": "MMS_PRODUCT",
  "meta": {
    "projectName": "MMS_PRODUCT",
    "exportFileName": "default",
    "description": "Analytical verification fixture (MMS). 1 CDU + 1 rack + 1 equivalent cold plate; synthetic parameters chosen so the lumped thermal network admits a closed-form step response. Not NV/vendor/site data; not a model of any real facility.",
    "inputUnit": "mm",
    "casePath": "",
    "provenance": {
      "fixture_revision": "mms-product-1",
      "source_project": "case/Shinaide_Liquid/Shinaide_hybrid_cpu.cfdproj",
      "template_sha256": "d00c6a0b32c350ec680b604e9da014507916a4d07bd4a90d1a20207290ee68bb",
      "topology": {
        "source": "mock",
        "reference": "tools/mms_product_project.ts",
        "description": "Single CDU zone, single rack with one equivalent server cold plate; one energy valve + one return tee + supply/return isolation valves, all fixed open. One equivalent pump and a two-fluid-volume HX (no vendor internal topology)."
      },
      "geometry": {
        "source": "mock",
        "description": "6 x 4 x 3 m minimal room; generic construction shapes cloned from own Shinaide fixture; line lengths from the common geometry compiler."
      },
      "thermal": {
        "source": "mock",
        "description": "UA_cp=100 W/K, C_solid=1000 J/K, V_fluid=2 L, UA_hx=500 W/K, baseline load 100 W, primary 0.1 kg/s at 290 K FIXED supply, primary/secondary mixed volumes 1 L / 2 L, water rho 997 / cp 4182. Chosen for analytic tractability (lumped linear thermal ODE with closed-form step response); secondary flow comes from the hydraulic solve and is asserted constant by the acceptance script."
      },
      "missing": [
        "everything real: this fixture exists only to verify the transient DAE solver against a manufactured closed form"
      ]
    }
  },
