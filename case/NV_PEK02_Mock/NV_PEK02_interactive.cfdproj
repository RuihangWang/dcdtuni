        "source": "mock",
        "rack_load_W": 10000,
        "total_load_W": 340000,
        "step_time_s": 5,
        "step_factor": 1.2,
        "description": "One equivalent liquid load/thermal mass per rack; not an individual GPU/cold-plate identification. Uniform 10 kW/rack chosen only for solver tests."
      },
