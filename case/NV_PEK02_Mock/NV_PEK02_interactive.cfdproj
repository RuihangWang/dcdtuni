      "topology": {
        "source": "mock",
        "reference": "tools/nv_mock_project.ts",
        "description": "Two independent CDU zones, 17 racks each, no cross-tie/standby. One equivalent pump and two-fluid-volume HX per CDU; not a model of the actual internal three-pump arrangement. One energy valve + supply isolation + return isolation per rack; isolation is a zero-volume series element co-located with its branch fitting."
      },
      "geometry": {
        "source": "mock",
        "description": "22 x 14 x 4 m assumed room; generic construction shapes cloned from own Shinaide fixture; 0.85 m assumed rack pitch. All line lengths come from the common geometry compiler, not NV CAD."
      },
