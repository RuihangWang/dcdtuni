FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 301.000000;

boundaryField
{
    floor
    {
        type            externalWallHeatFluxTemperature;
        mode            flux;
        q               uniform 0.2;
        kappaMethod     function;
        kappaValue      constant 0.017;
        alphaValue      constant 1.4285714285714286e-5;
        value           uniform 304.000000;
    }

    ceiling
    {
        type            fixedValue;
        value           uniform 300;
    }

    fixedWalls
    {
        type            zeroGradient;
    }
}


