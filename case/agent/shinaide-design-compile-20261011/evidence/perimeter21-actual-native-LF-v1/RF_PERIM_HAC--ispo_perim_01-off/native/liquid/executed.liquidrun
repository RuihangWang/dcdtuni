  "parameter_pack": {
    "description": "Synthetic single-phase water-loop parameters for software demonstrations only. These are not NVIDIA or Vertiv specifications. Replace this pack on the unresolved project input and rerun for vendor/calibrated data. Explicit mock two-mixed-volume HX interpretation; not NV measurements or calibrated vendor performance.",
    "id": "liquid-demo-equipment",
    "profiles": {
      "hx-demo": {
        "description": "",
        "params": {
          "UA_W_per_K": 2000,
          "dp_a": 20000,
          "dp_b": 5000
        },
