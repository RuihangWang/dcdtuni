      "classification": "Synthetic software verification input; not measured operating data or vendor calibration.",
      "topology": "Synthetic private engineering revision: independent supply/return rings, feed tees, rear/outlet paired manifolds, 14 preserved return controls. Ring selection follows user instruction; not a vendor-calibrated/as-built universal DC topology.",
      "geometry": "Only rear mounting, explicit CDU port frames and ring/feed/branch routing changed; original room/racks/servers/cold-plate equipment and loads retained. CDU ports 300mm centres and 100mm bore are authored engineering choices, not vendor dimensions. Added 30 explicit top-face slab passage cutouts for rear manifold stems and CDU exterior risers. Original cutouts retained.",
      "thermal": {
        "source": "mock",
        "description": "Original saved server/cold-plate loads retained, without calibration or a newly imposed load step. Initial fluid/solid temperature and pressure defaults come from liquid_graphgen.js; the parameter pack supplies synthetic cold-plate/copper capacities and conductances."
      },
      "primary_side": {
        "source": "mock",
        "flow_kg_s": 1,
        "inlet_K": 293.15,
        "primary_volume_m3": 0.02,
        "secondary_volume_m3": 0.02,
        "cp_J_kgK": 4180,
        "rho_kg_m3": 992.2,
        "source_reference": "Synthetic default adopted at Prepare/export: 1 kg/s primary inlet at 293.15 K, 0.02 m3 on each HX side; primary fluid cp/rho follow the saved project fluid. Not measured or calibrated vendor data."
      },
      "equipment_and_materials": {
        "source": "mock",
        "parameter_pack_id": "liquid-demo-equipment",
        "parameter_pack_revision": "mock-1-dae-v3",
        "source_reference": "src/backend/liquidcooling/data/mock-demo-v1.json; explicit two-mixed-volume HX interpretation from mockDAEChoices. Software assumptions only; no vendor performance or material calibration."
      },
      "experiment": {
        "duration_s": 180,
        "dt_s": 1,
        "load_step": false,
        "initial_mode": "steady",
        "description": "Preserves the original effective experiment time settings. Steady exports one operating point; the top-bar liquid transient switch enables the project timeline."
      },
      "display_only": [
        {
          "field": "constructions.cdus.m_30.cooling.totalFlowRate",
          "value": 60,
          "note": "This fixture uses pump curve control: totalFlowRate is not the pump flow equation input here. In explicit flow-control mode the compiler uses totalFlowRate. Primary-side flow is separately bound in primary_circuits.flow_kg_s."
        }
      ],
      "unresolved_physical_design": "Private candidate requires graph/DAE and live React/Three/OV acceptance. Pipe wall thickness, insulation, supports, leak containment/detection and maintenance clearances are not fully modelled; nominal bore used for geometric tube clearance.",
      "base_input_sha256": "594558e17f9618bf216fefd1f8788c31f7332b1bca00b6a7cadc25247316e626",
      "sealed_penetrations": {
        "status": "synthetic planned correction; actual renderer/STL coverage and original equipment cutout preservation tested",
        "model_uid": "m_52",
        "count": 30,
        "air_domain": "wall patches replace new open cutouts; original equipment cutouts retained exactly",
        "physical_interpretation": "sealed sleeves/grommets; pipe interior is excluded from air domain; patch is the air barrier and is not a liquid pressure boundary",
        "as_built_vendor_validation": false,
        "collar_dimensions_m": {
          "rack_branch_square": 0.04,
          "CDU_feeder_square": 0.15
        }
      },
      "feed_fittings": {
        "geometry": "100mm nominal fluid bores, 110mm outer visible fitting legs join ideal centre to all 3 port mouths",
        "hydraulic_model": "existing ideal mixing node, zero added internal volume/head loss; this is a declared lumped approximation, not vendor-calibrated finite T fitting",
        "status": "private synthetic correction; geometry evidence bound in review packet"
      },
      "route_display": {
        "mode": "explicit polyline; each authored main/feed straight and branch leg rendered separately with joints at exact bends",
        "pipe_length_and_fluid_storage": "DAE uses same authored polyline lengths and diameters; elbow losses use original K_minor_per_bend",
        "finite_elbow_and_T_storage": "ideal/lumped model approximation; displayed elbow joints and T bodies add no hidden stored coolant or calibrated internal pressure loss",
