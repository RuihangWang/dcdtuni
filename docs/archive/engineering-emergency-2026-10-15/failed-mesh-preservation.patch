+    @staticmethod
+    def _archive_dcCart_previous_outputs(case_dir: Path) -> Optional[Path]:
+        """Relocate prior native output before retry; keep inputs and other engines intact."""
+        if not case_dir.exists():
+            return None
+        case_dir = case_dir.resolve(strict=True)
+        prefixes = ("conforming-", "raw-native-", "generated-ap-", "thin-current-star-",
+                    "coverage-diagnostic-", "cap-birth-", "log.mpi_solver")
+        outputs = [entry for entry in sorted(case_dir.iterdir())
+                   if re.fullmatch(r"processor[0-9]+", entry.name)
+                   or (entry.is_file() and (entry.name.startswith(prefixes)
+                                           or entry.name == "seam-plane-coordinates.json"))]
+        if not outputs:
+            return None
+        for entry in outputs:
+            if entry.is_symlink() or not entry.resolve(strict=True).is_relative_to(case_dir):
+                raise RuntimeError(f"Refusing unsafe dcCart output archive: {entry}")
+        history = case_dir.parent / "_dcCart_mesh_history" / case_dir.name
+        if not history.resolve().is_relative_to(case_dir.parent):
+            raise RuntimeError(f"Refusing unsafe dcCart history path: {history}")
+        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
+        archive = history / f"{stamp}-pid{os.getpid()}-ns{time.monotonic_ns()}"
+        archive.mkdir(parents=True, exist_ok=False)
+        try:
+            # Same-filesystem rename preserves all bytes without copying a large mesh.
+            for entry in outputs:
+                entry.rename(archive / entry.name)
+        except OSError:
+            logger.error(f"dcCart retry stopped: prior output remains in {case_dir} and {archive}")
+            raise
+        logger.info(f"Archived previous dcCart native output from {case_dir} to {archive}")
+        return archive
+
