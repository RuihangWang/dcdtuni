+    ) -> Mapping[str, Iterable[Triangle]]:
+        """Reuse pure parsed geometry only within this dictionary-generation call.
+
+        Every lookup rereads and hashes the actual current bytes. A rewrite at
+        the same path, size or mtime cannot inherit an earlier parse. No Source
+        permission, manifest verification or receipt is cached here.
+        """
+        cache = getattr(self, "_mesh_dict_stl_parse_cache", None)
+        if cache is None:
+            return _read_ascii_stl_triangles(stl_path)
+        data = stl_path.read_bytes()
+        key = (str(stl_path.resolve()), hashlib.sha256(data).hexdigest(),
+               _ASCII_STL_PARSE_VERSION)
+        groups = cache.get(key)
+        if groups is None:
+            # TextIOWrapper has the same UTF-8 replacement and universal-newline
+            # behavior as the existing path reader, using these hashed bytes.
+            with io.TextIOWrapper(io.BytesIO(data), encoding="utf-8", errors="replace") as fh:
+                parsed = _parse_ascii_stl_triangle_lines(fh)
+            groups = MappingProxyType({name: tuple(triangles)
+                                       for name, triangles in parsed.items()})
+            cache[key] = groups
+        return groups
