+    unsupported = set(values) - _PROFILE_FIELDS[kind]
+    if unsupported:
+        raise ValueError(f"unsupported parameter for {kind}: {sorted(unsupported)}")
+    for name, value in values.items():
+        where = f"{location}.{name}"
+        if name == "n_cells":
