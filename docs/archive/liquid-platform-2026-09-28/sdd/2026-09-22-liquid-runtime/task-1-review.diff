+    cfg = runtime_config(samples=4)
+    a = LiquidSimulation(cfg, [controller(30000.0)])
+    b = LiquidSimulation(cfg, [controller(31000.0)])
+    before = a.config_hash
+    cfg.edges[-1].params["rpm_ratio"] = 0.2
