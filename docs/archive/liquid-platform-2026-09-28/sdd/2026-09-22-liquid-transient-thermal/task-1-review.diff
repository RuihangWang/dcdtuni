+def test_production_reverses_multicell_order_at_later_step():
+    raw = json.loads((Path(__file__).parent / 'minimal.liquidrun').read_text())
+    raw['time']['N_t'] = 4
+    raw['edges'][0]['params']['n_cells'] = 3
