+def test_hydraulic_failure_stops_before_thermal_publication():
+    g = loop_graph(n=3)
+    g.pump_params.rpm_ratio[0, 1] = float('nan')
+    model = LiquidODILModel(g)
+    with pytest.raises(RuntimeError, match='hydraulic solve failed'):
