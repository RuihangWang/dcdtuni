+    prev = list(initial(g))
+    prev[1][0] = float('nan')
+    with pytest.raises(ValueError, match='finite'):
+        step(g, torch.ones(g.N_edges, dtype=DTYPE), prev)
+    # No thermal storage/anchors: a pure adiabatic circulation has no temperature datum.
