+def test_pipe_distributed_source_and_initial_field_preserved():
+    g = pipe_graph()
+    g.cell_T_init = torch.tensor([319.], dtype=DTYPE)
+    g.cell_heat_W = torch.full((g.N_cells, g.N_t), 27., dtype=DTYPE)
