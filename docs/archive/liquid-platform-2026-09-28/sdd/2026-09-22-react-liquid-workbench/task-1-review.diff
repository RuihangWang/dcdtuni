@@ -0,0 +1,95 @@
+import { useMemo, useState, useSyncExternalStore } from 'react'
+import type { CfdProject } from '../schema/cfdproj'
+import * as store from '../projectStore'
+import { compileDynamicLiquidGraph } from '../liquid/dynamicLiquidGraph'
+import { buildExperiment, type ExperimentSettings } from '../liquid/liquidExperiment'
+import * as runtime from '../liquid/liquidRuntimeClient'
+import { LiquidSolverPanel } from './LiquidSolverPanel'
+
+const statusLabels:Record<runtime.RuntimeStatus,string>={ready:'已就绪',running:'运行中',paused:'已暂停',completed:'已完成',cancelled:'已取消',failed:'失败'}
+export function LiquidExperimentPanel({project}:{project:CfdProject|null}) {
+  const state=useSyncExternalStore(runtime.subscribeRuntime,runtime.runtimeState)
+  const revision=useSyncExternalStore(store.subscribe,store.revision)
+  const [duration,setDuration]=useState(180)
+  const [dt,setDt]=useState(1)
+  const [speed,setSpeed]=useState('10')
+  const [error,setError]=useState<string|null>(null)
+  const [settings,setSettings]=useState<ExperimentSettings>({mode:'manual',pumpId:'',measurementId:'',setpoint:45,kp:.03,ki:.002,bias:.8,loadStep:false,stepTime:60,loadFactor:1.5})
+  const [catalog,setCatalog]=useState<{pumps:string[];plates:string[]}>({pumps:[],plates:[]})
+  const change=<K extends keyof ExperimentSettings>(key:K,value:ExperimentSettings[K])=>setSettings(s=>({...s,[key]:value}))
+  const status=state.session?.status
+  const active=status==='running'||status==='paused'||status==='ready'
+  const stale=state.session&&state.projectRevision!==revision
+  const frame=state.session?.frame
+  const progress=useMemo(()=>state.session?(frame?.seq??0)/Math.max(1,state.session.metadata.total_sample_count-1):0,[state.session,frame])
+  async function create() {
+    if(!project)return
+    setError(null)
+    try {
+      const graph=compileDynamicLiquidGraph(project,{duration_s:duration,dt_s:dt})
+      const pumps=graph.edges.filter(e=>e.type==='pump').map(e=>e.id)
+      const plates=graph.edges.filter(e=>e.type==='cold_plate').map(e=>e.id)
+      setCatalog({pumps,plates})
+      const next={...settings,pumpId:pumps.includes(settings.pumpId)?settings.pumpId:pumps[0]??'',measurementId:plates.includes(settings.measurementId)?settings.measurementId:plates[0]??''}
+      setSettings(next)
+      const scenario=buildExperiment(graph,next)
+      await runtime.createRuntimeSession(scenario.liquidrun,scenario.controllers,revision)
+    }catch(e){setError(e instanceof Error?e.message:String(e))}
+  }
+  async function action(kind:'start'|'pause'|'resume'|'cancel'|'step') {
+    setError(null)
+    try {await runtime.runtimeAction(kind,speed==='fast'?null:Number(speed));await runtime.refreshRuntimeFrames()}
+    catch(e){setError(e instanceof Error?e.message:String(e))}
+  }
+  async function download(kind:'result'|'checkpoint') {
+    try {
+      const id=state.session?.run_id
+      const value=kind==='result'?await runtime.fetchRuntimeResult():await runtime.fetchRuntimeCheckpoint()
+      const url=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:'application/json'}))
+      const a=document.createElement('a');a.href=url;a.download=`liquid-${id}-${kind}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)
+    }catch(e){setError(e instanceof Error?e.message:String(e))}
+  }
+  const number=(label:string,value:number,onChange:(value:number)=>void,step=1)=><label className="liquid-experiment-field"><span>{label}</span><input type="number" value={Number.isNaN(value)?'':value} step={step} onChange={e=>onChange(e.target.valueAsNumber)}/></label>
+  return <div className="content liquid-experiment" id="liquid-experiment-panel">
+    <h3>液冷动态实验</h3>
+    <p className="liquid-experiment-note">CDU—管网—冷板联动。泵、换热器与阀门使用可替换的 mock 参数；设备几何和冷板参数来自当前工程。</p>
+    <fieldset disabled={state.busy||!!active}>
+      <legend>时间与负载</legend>
+      {number('仿真时长 / s',duration,setDuration)}
+      {number('时间步长 / s',dt,setDt,.1)}
+      <label className="liquid-experiment-check"><input type="checkbox" checked={settings.loadStep} onChange={e=>change('loadStep',e.target.checked)}/>添加冷板负载阶跃</label>
+      {settings.loadStep&&<>{number('阶跃时刻 / s',settings.stepTime,v=>change('stepTime',v))}{number('负载倍率',settings.loadFactor,v=>change('loadFactor',v),.1)}<p className="liquid-experiment-note">所有冷板按各自基准热功率乘以此倍率；此值是液体侧热负载。</p></>}
+      <legend>泵控制</legend>
+      <label className="liquid-experiment-field"><span>控制方式</span><select value={settings.mode} onChange={e=>{
+        const mode=e.target.value as ExperimentSettings['mode'];setSettings(s=>({...s,mode,setpoint:mode==='pressure'?30:45,kp:mode==='pressure'?.01:.03,ki:mode==='pressure'?.001:.002}))
+      }}><option value="manual">固定转速</option><option value="temperature">冷板温度 PI</option><option value="pressure">泵压差 PI</option></select></label>
+      {settings.mode!=='manual'&&<>
+        <label className="liquid-experiment-field"><span>执行泵</span><select value={settings.pumpId} onChange={e=>change('pumpId',e.target.value)}><option value="">首个可用泵</option>{catalog.pumps.map(id=><option key={id}>{id}</option>)}</select></label>
+        {settings.mode==='temperature'&&<label className="liquid-experiment-field"><span>测温冷板</span><select value={settings.measurementId} onChange={e=>change('measurementId',e.target.value)}><option value="">首个可用冷板</option>{catalog.plates.map(id=><option key={id}>{id}</option>)}</select></label>}
+        {number(settings.mode==='temperature'?'设定温度 / °C':'泵压差 / kPa',settings.setpoint,v=>change('setpoint',v),.1)}
+        {number(settings.mode==='temperature'?'Kp / K⁻¹':'Kp / kPa⁻¹',settings.kp,v=>change('kp',v),.001)}
+        {number(settings.mode==='temperature'?'Ki / (K·s)⁻¹':'Ki / (kPa·s)⁻¹',settings.ki,v=>change('ki',v),.001)}
+        {number('初始输出比例',settings.bias,v=>change('bias',v),.05)}
+        <p className="liquid-experiment-note">输出 0.2–1.0，每秒最大变化 0.05。增益为演示初值，需按设备和工况整定。</p>
+      </>}
+    </fieldset>
+    <label className="liquid-experiment-field"><span>播放速度</span><select value={speed} disabled={status==='running'} onChange={e=>setSpeed(e.target.value)}><option value="1">1×</option><option value="10">10×</option><option value="fast">最快计算</option></select></label>
+    <div className="liquid-experiment-actions">
+      <button className="btn" onClick={()=>void create()} disabled={!project||state.busy||!!active}>{state.session?'新建实验':'准备实验'}</button>
+      {status==='ready'&&<button className="btn success" disabled={state.busy} onClick={()=>void action('start')}>开始</button>}
+      {status==='running'&&<button className="btn" disabled={state.busy} onClick={()=>void action('pause')}>暂停</button>}
+      {status==='paused'&&<button className="btn success" disabled={state.busy} onClick={()=>void action('resume')}>继续</button>}
+      {(status==='paused'||status==='ready')&&<button className="btn" disabled={state.busy} onClick={()=>void action('step')}>单步</button>}
+      {active&&<button className="btn" disabled={state.busy} onClick={()=>void action('cancel')}>结束实验</button>}
+    </div>
+    {state.session&&<div aria-live="polite" className="liquid-experiment-status">
+      <strong>{statusLabels[state.session.status]} · {frame?.time_s.toFixed(1)} s</strong>
+      <progress value={progress} max={1}/>
+      <small>运行 {state.session.run_id.slice(0,12)} · {state.session.config_hash.slice(0,10)}</small>
