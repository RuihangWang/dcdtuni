+      <div className="liquid-experiment-actions"><button className="btn" onClick={()=>void download('result')}>导出结果</button><button className="btn" onClick={()=>void download('checkpoint')}>保存检查点</button></div>
+    </div>}
+    {(error||state.error||state.session?.error)&&<p role="alert" className="error">{error||state.error||state.session?.error}</p>}
+    <details className="liquid-experiment-legacy"><summary>旧版边界条件求解</summary><LiquidSolverPanel project={project}/></details>
+  </div>
+}
