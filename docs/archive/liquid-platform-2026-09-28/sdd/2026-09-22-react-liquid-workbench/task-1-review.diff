+import { useState, useSyncExternalStore } from 'react'
+import * as runtime from '../liquid/liquidRuntimeClient'
+import { TimeSeriesChart } from './TimeSeriesChart'
+import { LiquidMonitorPanel } from './LiquidMonitorPanel'
+export function LiquidRuntimeMonitor() {
+  const state=useSyncExternalStore(runtime.subscribeRuntime,runtime.runtimeState)
+  const [selected,setSelected]=useState('')
+  const [tab,setTab]=useState<'runtime'|'legacy'>('runtime')
+  const session=state.session
+  const frame=session?.frame
+  const metadata=session?.metadata
+  const cpIndex=Math.max(0,metadata?.cp_edge_ids.indexOf(selected)??0)
+  const cpId=metadata?.cp_edge_ids[cpIndex]
+  const edgeIndex=metadata?.edge_ids.indexOf(cpId??'')??-1
+  const time=state.frames.map(f=>f.time_s)
+  const label=cpId??'冷板'
+  const temperature=state.frames.map(f=>(f.chip_temp_K[cpIndex]??NaN)-273.15)
+  const flow=state.frames.map(f=>f.edge_flow_kg_s[edgeIndex]??NaN)
+  const controller=frame?Object.keys(frame.controls)[0]:undefined
+  const thermal=frame?.diagnostics.thermal as {energy_balance_W?:number}|undefined
+  return <div className="content liquid-experiment" id="liquid-runtime-monitor">
+    <div className="subtab-bar"><button className={`subtab${tab==='runtime'?' active':''}`} onClick={()=>setTab('runtime')}>动态实验</button><button className={`subtab${tab==='legacy'?' active':''}`} onClick={()=>setTab('legacy')}>旧版监视</button></div>
+    {tab==='legacy'?<LiquidMonitorPanel/>:!session?<p>在左侧准备实验，随后查看温度、流量和控制输出。</p>:<>
+      <h3>联动监视</h3>
+      <p aria-live="polite">仿真时间 <strong>{frame?.time_s.toFixed(1)} s</strong> · {state.frames.length} 帧{state.connection==='reconnecting'?' · 正在重连':''}</p>
+      <label className="liquid-experiment-field"><span>冷板</span><select value={cpId??''} onChange={e=>setSelected(e.target.value)}>{metadata?.cp_edge_ids.map(id=><option key={id}>{id}</option>)}</select></label>
+      <h4>冷板温度 / °C</h4><TimeSeriesChart time={time} series={[{label,color:'#e7a967',points:temperature}]} xLabel="时间 / s" yLabel="°C" height={175}/>
+      <h4>冷板质量流量 / kg/s</h4><TimeSeriesChart time={time} series={[{label,color:'#65b7df',points:flow}]} xLabel="时间 / s" yLabel="kg/s" height={150}/>
+      {controller&&<><h4>泵输出比例</h4><TimeSeriesChart time={time} series={[{label:'泵速',color:'#8fc8a5',points:state.frames.map(f=>f.controls[controller]?.output??NaN)}]} xLabel="时间 / s" yLabel="ratio" height={150}/><p>{frame?.controls[controller]?.saturated?'输出触及限幅':'输出在范围内'}{frame?.controls[controller]?.rate_limited?' · 变化率受限':''}</p></>}
+      {thermal?.energy_balance_W!==undefined&&<p className="liquid-experiment-note">热平衡残差 {thermal.energy_balance_W.toExponential(2)} W</p>}
+      <p className="liquid-experiment-note">图表使用同一运行的物理时间；温度由 K 换算为 °C。能量残差衡量数值守恒，不表示设备模型已由现场验证。</p>
+    </>}
+  </div>
+}
diff --git a/src/frontend/react/src/liquid/liquidExperiment.ts b/src/frontend/react/src/liquid/liquidExperiment.ts
new file mode 100644
index 00000000..95dbb9b3
--- /dev/null
+++ b/src/frontend/react/src/liquid/liquidExperiment.ts
@@ -0,0 +1,39 @@
+/** Physical scenario construction shared by the React controls and browser automation. */
+import type { DynamicLiquidGraph } from './dynamicLiquidGraph'
+export interface ExperimentSettings {
+  mode:'manual'|'temperature'|'pressure';pumpId:string;measurementId:string;
+  setpoint:number;kp:number;ki:number;bias:number;
+  loadStep:boolean;stepTime:number;loadFactor:number;
+}
+export function buildExperiment(graph:DynamicLiquidGraph, settings:ExperimentSettings) {
+  const liquidrun=structuredClone(graph)
+  const {dt_s,N_t}=graph.time
+  if(settings.loadStep) {
+    const {stepTime,loadFactor}=settings
+    if(!Number.isFinite(stepTime)||stepTime<=0||stepTime>(N_t-1)*dt_s||Math.abs(stepTime/dt_s-Math.round(stepTime/dt_s))>1e-8)throw new Error('Load step must lie on the simulation time grid')
+    if(!Number.isFinite(loadFactor)||loadFactor<0)throw new Error('Load multiplier must be finite and nonnegative')
+    for(const edge of liquidrun.edges.filter(e=>e.type==='cold_plate')) {
+      const baseline=Number(edge.params.Q_W)
+      if(!Number.isFinite(baseline)||baseline<0)throw new Error(`Invalid baseline heat load on ${edge.id}`)
+      liquidrun.events.push({time_s:stepTime,target:edge.id,field:'Q_W',value:baseline*loadFactor})
+    }
+  }
+  const controllers=[]
+  if(settings.mode!=='manual') {
+    const pump=graph.edges.find(e=>e.id===settings.pumpId&&e.type==='pump')
+    if(!pump)throw new Error('Select a pump from this physical model')
+    if(![settings.setpoint,settings.kp,settings.ki,settings.bias].every(Number.isFinite)||settings.kp<0||settings.ki<0||settings.bias<.2||settings.bias>1)throw new Error('PID gains must be nonnegative and initial output must be 0.2–1.0')
+    const temperature=settings.mode==='temperature'
+    if(temperature&&!graph.edges.some(e=>e.id===settings.measurementId&&e.type==='cold_plate'))throw new Error('Select a cold plate from this physical model')
+    if(temperature&&settings.setpoint<=-273.15)throw new Error('Temperature setpoint must exceed absolute zero')
+    if(!temperature&&settings.setpoint<=0)throw new Error('Pressure setpoint must be positive')
+    controllers.push({id:'editor-pump-pid',measurement:temperature?
+      {kind:'solid_temperature',target_id:settings.measurementId}:
+      {kind:'pressure_difference',target_id:pump.to,reference_id:pump.from},
+      actuator:{edge_id:pump.id,field:'rpm_ratio'},
+      pid:{kp:settings.kp/(temperature?1:1000),ki:settings.ki/(temperature?1:1000),kd:0,
+        setpoint:temperature?settings.setpoint+273.15:settings.setpoint*1000,action:temperature?'direct':'reverse',
+        bias:settings.bias,output_min:.2,output_max:1,rate_limit_per_s:.05},sample_period_s:dt_s})
+  }
+  return {liquidrun,controllers}
+}
diff --git a/src/frontend/react/src/liquid/liquidRuntimeClient.ts b/src/frontend/react/src/liquid/liquidRuntimeClient.ts
new file mode 100644
index 00000000..9f8d545d
--- /dev/null
+++ b/src/frontend/react/src/liquid/liquidRuntimeClient.ts
@@ -0,0 +1,147 @@
+/** Runtime transport; simulation ownership stays on the server across reconnects. */
+export type RuntimeStatus = 'ready'|'running'|'paused'|'completed'|'cancelled'|'failed'
+export interface RuntimeFrame {
+  kind:'frame'; run_id:string; seq:number; time_s:number;
+  node_pressure_Pa:number[]; node_temperature_K:number[]; edge_flow_kg_s:number[];
+  chip_temp_K:number[]; edge_outlet_temp_K:number[];
+  controls:Record<string,{measurement:number;setpoint:number;output:number;saturated:boolean;rate_limited:boolean}>;
+  diagnostics:Record<string,unknown>;
+}
+export interface RuntimeMetadata {
+  node_ids:string[]; edge_ids:string[]; cp_edge_ids:string[];
+  total_sample_count:number; dt_s:number; config_hash?:string;
+  object_bindings:Record<string,{label:string;kind:string;node_ids:string[];edge_ids:string[];parent_uid?:string}>;
+  parameter_provenance?:Record<string,unknown>;
+}
+export interface RuntimeSession {run_id:string;status:RuntimeStatus;config_hash:string;metadata:RuntimeMetadata;frame:RuntimeFrame;error?:string|null}
+export interface RuntimeClientState {
+  session:RuntimeSession|null; frames:RuntimeFrame[]; projectRevision:number|null;
+  busy:boolean; error:string|null; connection:'idle'|'connected'|'reconnecting';
+}
+const EMPTY:RuntimeClientState = {session:null,frames:[],projectRevision:null,busy:false,error:null,connection:'idle'}
+let state:RuntimeClientState = EMPTY
+let generation=0
+let frameCursor=-1
+let lifecycleRevision=0
+let timer:ReturnType<typeof setTimeout>|null=null
+let polling=false
+const listeners = new Set<()=>void>()
+export function subscribeRuntime(listener:()=>void) {listeners.add(listener);return ()=>{listeners.delete(listener)}}
+export function runtimeState() {return state}
+function update(patch:Partial<RuntimeClientState>) {state={...state,...patch};listeners.forEach(f=>f())}
+function errorText(error:unknown) {return error instanceof Error?error.message:String(error)}
+export function stopRuntimePolling() {polling=false;if(timer!==null)clearTimeout(timer);timer=null}
+export function resetRuntimeClient() {stopRuntimePolling();generation++;frameCursor=-1;state=EMPTY;listeners.forEach(f=>f())}
+
+async function request(path:string,body?:unknown) {
+  const response=await fetch(path,body===undefined?undefined:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
+  const value=await response.json()
+  if(!response.ok)throw new Error(value?.error||`Request failed (${response.status})`)
+  return value
+}
+function checkedFrame(value:RuntimeFrame, id:string, metadata:RuntimeMetadata):RuntimeFrame {
+  if(!value||value.kind!=='frame'||value.run_id!==id)throw new Error('Frame belongs to a different liquid run')
+  if(!Number.isSafeInteger(value.seq)||value.seq<0||!Number.isFinite(value.time_s)||value.time_s<0)throw new Error('Invalid simulation frame time')
+  for(const [values,size] of [
+    [value.node_pressure_Pa,metadata.node_ids.length], [value.node_temperature_K,metadata.node_ids.length],
+    [value.edge_flow_kg_s,metadata.edge_ids.length], [value.chip_temp_K,metadata.cp_edge_ids.length],
+    [value.edge_outlet_temp_K,metadata.edge_ids.length],
+  ] as [number[],number][]) {
+    if(!Array.isArray(values)||values.length!==size||values.some(v=>typeof v!=='number'||!Number.isFinite(v)))throw new Error('Simulation frame does not match its physical model')
+  }
+  return value
+}
+function mergeFrames(incoming:RuntimeFrame[], session:RuntimeSession) {
+  // Validate the complete response before changing any displayed state.
+  const valid=incoming.map(f=>checkedFrame(f,session.run_id,session.metadata))
+  const frames=new Map(state.frames.map(f=>[f.seq,f]))
+  valid.forEach(f=>frames.set(f.seq,f))
+  return [...frames.values()].sort((a,b)=>a.seq-b.seq)
+}
+
+export async function createRuntimeSession(liquidrun:unknown,controllers:unknown[],projectRevision:number):Promise<RuntimeSession|null> {
+  stopRuntimePolling()
+  const token=++generation
+  update({busy:true,error:null,connection:'idle'})
+  try {
+    const session=await request('/api/liquid/runs',{liquidrun,controllers,project_revision:projectRevision}) as RuntimeSession
+    if(token!==generation)return null
+    checkedFrame(session.frame,session.run_id,session.metadata)
+    frameCursor=session.frame.seq===0?0:-1
+    update({session,frames:[session.frame],projectRevision,busy:false,connection:'connected'})
+    return session
+  } catch(error) {
+    if(token!==generation)return null
+    update({busy:false,error:errorText(error)})
+    throw error
+  }
+}
+
+export async function refreshRuntimeFrames():Promise<void> {
+  const session=state.session
+  if(!session)return
+  const token=generation
+  const after=frameCursor
+  const lifecycle=lifecycleRevision
+  try {
+    const payload=await request(`/api/liquid/runs/${encodeURIComponent(session.run_id)}/frames?after=${after}`)
+    if(token!==generation||state.session?.run_id!==session.run_id)return
+    if(!Array.isArray(payload.frames))throw new Error('Runtime response has no frame sequence')
+    const frames=mergeFrames(payload.frames,session)
+    frameCursor=Math.max(frameCursor,...payload.frames.map((frame:RuntimeFrame)=>frame.seq))
+    const latest=frames.at(-1)??session.frame
+    const current=state.session!
+    const status=lifecycle===lifecycleRevision&&!state.busy?(payload.status??current.status):current.status
+    update({frames,session:{...current,status,frame:latest,error:payload.error??current.error},connection:'connected',error:null})
+  } catch(error) {
+    if(token===generation)update({connection:'reconnecting',error:errorText(error)})
+    throw error
+  }
+}
+
+export function startRuntimePolling(intervalMs=500) {
+  stopRuntimePolling();polling=true
+  const token=generation
+  let failures=0
+  const poll=async()=>{
+    if(!polling||token!==generation)return
+    try {await refreshRuntimeFrames();failures=0}catch{failures++}
+    if(!polling||token!==generation)return
+    const status=state.session?.status
+    if(status==='completed'||status==='cancelled'||status==='failed') {stopRuntimePolling();return}
+    timer=setTimeout(()=>{void poll()},Math.min(5000,intervalMs*Math.max(1,2**Math.min(failures,4))))
+  }
+  timer=setTimeout(()=>{void poll()},intervalMs)
+}
+
+export async function runtimeAction(action:'start'|'pause'|'resume'|'cancel'|'step',speed:number|null=null):Promise<void> {
+  const session=state.session
+  if(!session)throw new Error('No liquid simulation session')
+  lifecycleRevision++
+  const token=generation
+  update({busy:true,error:null})
+  try {
+    const next=await request(`/api/liquid/runs/${encodeURIComponent(session.run_id)}/${action}`,action==='start'||action==='resume'?{speed}:{}) as RuntimeSession
+    if(token!==generation||state.session?.run_id!==session.run_id)return
+    if(next.run_id!==session.run_id)throw new Error('Operation acknowledgment belongs to a different run')
+    const frames=mergeFrames(next.frame?[next.frame]:[],session)
+    lifecycleRevision++
+    update({session:{...session,...next,frame:frames.at(-1)??next.frame},frames,busy:false,connection:'connected'})
+    if(action==='start'||action==='resume')startRuntimePolling()
+    if(action==='cancel')stopRuntimePolling()
+  } catch(error) {
+    if(token===generation)update({busy:false,error:errorText(error)})
+    throw error
+  }
+}
+
+export async function fetchRuntimeResult():Promise<unknown> {
+  const id=state.session?.run_id
+  if(!id)throw new Error('No liquid simulation session')
+  return request(`/api/liquid/runs/${encodeURIComponent(id)}/result`)
+}
+export async function fetchRuntimeCheckpoint():Promise<unknown> {
+  const id=state.session?.run_id
+  if(!id)throw new Error('No liquid simulation session')
+  return request(`/api/liquid/runs/${encodeURIComponent(id)}/checkpoint`)
+}
