+// check still decides whether the final discretisation is acceptable.
+bool vertexConvexFaces
+(
+    const Foam::dcCartCutCells::cutMesh& m,
+    const std::vector<Foam::label>& fs, Foam::label c, Foam::label o = -1
+)
+{
+    using namespace Foam;
+    if (getenv("DCCART_CONVEX_MERGES") == nullptr) { return true; }
+    std::vector<label> vertices;
+    point lo(GREAT, GREAT, GREAT), hi(-GREAT, -GREAT, -GREAT);
+    for (const label f : fs)
+    {
+        if (!m.faceAlive[f]) { continue; }
+        for (const label p : m.faces[f])
+        {
+            vertices.push_back(p);
+            lo = min(lo, m.points[p]); hi = max(hi, m.points[p]);
+        }
+    }
+    std::sort(vertices.begin(), vertices.end());
+    vertices.erase(std::unique(vertices.begin(), vertices.end()), vertices.end());
+    if (vertices.size() < 4) { return false; }
+    const scalar tolerance = 1e-10 * max(mag(hi-lo), scalar(1e-6));
+    for (const label f : fs)
+    {
+        if (!m.faceAlive[f]) { continue; }
+        vector a; point fc; faceAreaCentreOF(m.points, m.faces[f], a, fc);
+        const scalar ar = mag(a);
+        if (ar <= VSMALL) { return false; }
+        const bool outward = m.owner[f] == c || (o >= 0 && m.owner[f] == o);
+        const vector n = (outward ? a : vector(-a)) / ar;
+        for (const label p : vertices)
+        {
+            if (((m.points[p] - fc) & n) > tolerance) { return false; }
+        }
+    }
+    return true;
+}
