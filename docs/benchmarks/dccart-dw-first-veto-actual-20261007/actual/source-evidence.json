        "text": "             || (!dw && after.faceQuality[targetIndex][1]<.01)"
      },
      {
        "line": 1846,
        "text": "             || (dw && hardDWCount(stencil,after)>=hardDWCount(stencil,before))"
      },
      {
        "line": 1847,
        "text": "             || !qualityLineage(stencil,before,after,ceiling)"
      },
      {
        "line": 1848,
        "text": "             || !geometricGuard(stencil,before,after,candidate)"
      },
      {
        "line": 1849,
        "text": "             || !pointClearance(workingPoints,moving,candidate,stencil,available)) continue;"
      },
      {
        "line": 1850,
        "text": "            // Accumulate all newly passing hard roles before replacing the"
      },
      {
        "line": 1851,
        "text": "            // local prefix. The final installed oracle must retain them."
      },
      {
        "line": 1852,
        "text": "            if (!prefixRoles(acceptedRoles,stencil,after,true)) continue;"
      },
      {
        "line": 1853,
        "text": "            }"
      }
    ]
  }
}
