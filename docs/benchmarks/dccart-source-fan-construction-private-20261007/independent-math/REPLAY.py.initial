def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def bitsfrac(h):
    assert re.fullmatch('[0-9a-f]{16}',h);v=int(h,16);sgn=-1 if v>>63 else 1;e=(v>>52)&2047;m=v&((1<<52)-1);assert e!=2047
    power=(e-1023-52) if e else -1074;n=(m+(1<<52)) if e else m
    return Q(sgn*n*(1<<power),1) if power>=0 else Q(sgn*n,1<<(-power))
def point(b):return tuple(map(bitsfrac,b))
def sub(a,b):return tuple(a[i]-b[i] for i in range(3))
def cross(a,b):return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])
def dot(a,b):return sum((a[i]*b[i] for i in range(3)),Q(0))
def rref(rows,n):
    a=[list(row) for row in rows];piv=[];k=0
    for col in range(n):
        pick=next((i for i in range(k,len(a)) if a[i][col]),None)
        if pick is None:continue
        a[k],a[pick]=a[pick],a[k];d=a[k][col];a[k]=[x/d for x in a[k]]
        for i in range(len(a)):
            if i!=k:
                d=a[i][col];a[i]=[x-d*y for x,y in zip(a[i],a[k])]
        piv.append(col);k+=1
    return a,piv

def plane(r):
    assert len(r)>=3;n=None
    for i in range(1,len(r)-1):
        c=cross(sub(r[i],r[0]),sub(r[i+1],r[0]))
        if any(c):n=c;break
    assert n is not None
    first=next(x for x in n if x);n=tuple(x/first for x in n);d=dot(n,r[0]);assert all(dot(n,x)==d for x in r)
    axes=[k for k in range(3) if all(x[k]==r[0][k] for x in r)];assert len(axes)==1
    return n,d,axes[0]

def moments(r):
    av=[Q(0)]*3;mt=[[Q(0) for _ in range(3)] for _ in range(3)];a=r[0]
    for i in range(1,len(r)-1):
        b,c=r[i],r[i+1];n=cross(sub(b,a),sub(c,a));s=[a[j]+b[j]+c[j] for j in range(3)]
        for k in range(3):
            av[k]+=n[k]
            for j in range(3):mt[k][j]+=n[k]*s[j]
    return av,mt

def sum_moments(rings):
    av=[Q(0)]*3;mt=[[Q(0) for _ in range(3)] for _ in range(3)]
    for ring in rings:
        a,m=moments(ring)
        for k in range(3):
            av[k]+=a[k]
            for j in range(3):mt[k][j]+=m[k][j]
    return av,mt

def enc(x):
    if isinstance(x,Q):return str(x)
    if isinstance(x,dict):return {str(k):enc(v) for k,v in x.items()}
    if isinstance(x,(list,tuple)):return [enc(v) for v in x]
    return x

