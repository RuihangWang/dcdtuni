+                 <<",\"zone\":"<<raw.zone[f]<<",\"alive\":"<<(raw.faceAlive[f]?"true":"false")<<",\"worldBits\":[";
+                for(std::size_t k=0;k<ring.size();++k){if(k)o<<',';coordinate(o,raw.points[ring[k]]);}
+                o<<"]}";
+            }
+            o<<"]}";event(o.str());
+        }
+        catch(...){complete_=false;}
+    }
+    bool rejected(const char* site,label source=-1,label face=-1,label i=-1,label j=-1) noexcept
+    {
+        if(active_&&complete_)
+        {
