{
  "schemaVersion": 5,
  "uid": "proj_Shinaide",
  "name": "DomainAsset_Compat_Synthetic",
  "meta": {
    "projectName": "DomainAsset_Compat_Synthetic",
    "exportFileName": "default",
    "description": "Renderer-independent domain migration compatibility proof; synthetic equipment.",
    "inputUnit": "mm",
    "casePath": "/mnt/lv/home/litianyu/mycode/dcdtuni/.codex-tmp/goal-20261005/integration/.codex-tmp/cases/Shinaide_LiquidMixed_Keyframe_CUA",
    "provenance": {
      "fixture_revision": "shinaide-canonical-synthetic-dae-1",
      "classification": "Synthetic software verification input; not measured operating data or vendor calibration.",
      "topology": {
        "source": "mock",
        "rack_count": 14,
        "server_count": 56,
        "description": "14 racks / 56 liquid-cooled servers, one equivalent CDU pump and two-volume HX loop. Authored Shinaide topology, not an as-built P&ID."
      },
      "geometry": {
        "source": "mock",
        "description": "Original authored positions, dimensions, ports, pipe radii and routes retained. Pipe lengths remain derived by the shared geometry compiler; no physical port-layout correction or validation is implied."
      },
      "thermal": {
        "source": "mock",
        "description": "Original saved server/cold-plate loads retained, without calibration or a newly imposed load step. Initial fluid/solid temperature and pressure defaults come from liquid_graphgen.js; the parameter pack supplies synthetic cold-plate/copper capacities and conductances."
      },
      "primary_side": {
        "source": "mock",
        "flow_kg_s": 1,
        "inlet_K": 293.15,
        "primary_volume_m3": 0.02,
        "secondary_volume_m3": 0.02,
        "cp_J_kgK": 4180,
        "rho_kg_m3": 992.2,
        "source_reference": "Synthetic default adopted at Prepare/export: 1 kg/s primary inlet at 293.15 K, 0.02 m3 on each HX side; primary fluid cp/rho follow the saved project fluid. Not measured or calibrated vendor data."
      },
      "equipment_and_materials": {
        "source": "mock",
        "parameter_pack_id": "liquid-demo-equipment",
        "parameter_pack_revision": "mock-1-dae-v3",
        "source_reference": "src/backend/liquidcooling/data/mock-demo-v1.json; explicit two-mixed-volume HX interpretation from mockDAEChoices. Software assumptions only; no vendor performance or material calibration."
      },
      "experiment": {
        "duration_s": 180,
        "dt_s": 1,
        "load_step": false,
        "initial_mode": "steady",
        "description": "Preserves the original effective experiment time settings. Steady exports one operating point; the top-bar liquid transient switch enables the project timeline."
      },
      "display_only": [
        {
          "field": "constructions.cdus.m_30.cooling.totalFlowRate",
          "value": 60,
          "note": "This fixture uses pump curve control: totalFlowRate is not the pump flow equation input here. In explicit flow-control mode the compiler uses totalFlowRate. Primary-side flow is separately bound in primary_circuits.flow_kg_s."
        }
      ],
      "unresolved_physical_design": {
        "description": "The authored rear ports have 50 mm centre spacing with 100 mm pipe diameters, and the current route approaches from inside the cabinet. This provenance records the ambiguity without changing port positions, routes, pipe radii or topology; the display clipping policy is not a physical design repair."
      }
    }
  },
