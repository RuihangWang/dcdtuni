+import { readFileSync, existsSync } from 'node:fs'
+import { resolve } from 'node:path'
+import vm from 'node:vm'
+import { spawnSync } from 'node:child_process'
+import { modelPoseKernel } from '../src/domain/modelPoseKernel'
