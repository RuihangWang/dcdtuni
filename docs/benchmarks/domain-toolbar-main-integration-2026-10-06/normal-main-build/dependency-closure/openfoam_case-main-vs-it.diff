+def resolve_global_air_material(simulation_config: Dict[str, Any]) -> Dict[str, Any]:
+    """Pure shared producer for the supported one-material Boussinesq air run.
+    This establishes material equality, never per-cell geometry ownership.
+    Unsupported override models or legacy nonempty thermophysical input refuse.
+    """
+    from backend.aircooling.utils.const import rho_air, air_specific_heat
+    import math
+    sc = simulation_config or {}
+    if not isinstance(sc, dict):
+        raise ValueError("unknown global air config")
+    mode = sc.get("solverType", "steady") or "steady"
+    if mode not in ("steady", "transient"):
+        raise ValueError("unsupported solver mode")
+    supported = ("buoyantBoussinesqSimpleFoam_new" if mode == "steady"
+                 else "buoyantBoussinesqPimpleFoam_new")
+    solver = sc.get("solverName") or supported
+    if solver != supported:
+        raise ValueError("unsupported single-phase air solver")
+    if sc.get("physical_properties", {}):
+        raise ValueError("unreviewed legacy physical-property override")
+    room = float(22.0 if sc.get("roomTemperature") is None else sc["roomTemperature"])
