      "lines": [
        {
          "line": 87,
          "text": "export async function createRuntimeSession(liquidrun:unknown,controllers:unknown[],projectRevision:number):Promise<RuntimeSession|null> {"
        },
        {
          "line": 88,
          "text": "  stopRuntimePolling()"
        },
        {
          "line": 89,
          "text": "  const token=++generation"
        },
        {
          "line": 90,
          "text": "  update({busy:true,error:null,connection:'idle'})"
        },
        {
          "line": 91,
          "text": "  try {"
        },
        {
          "line": 92,
          "text": "    const session=await request('/api/liquid/runs',{liquidrun,controllers,project_revision:projectRevision}) as RuntimeSession"
        },
        {
          "line": 93,
          "text": "    if(token!==generation)return null"
        },
        {
          "line": 94,
          "text": "    checkedFrame(session.frame,session.run_id,session.metadata)"
        },
        {
          "line": 95,
          "text": "    frameCursor=session.frame.seq===0?0:-1"
        },
        {
          "line": 96,
          "text": "    update({session,frames:[session.frame],projectRevision,busy:false,connection:'connected'})"
        },
        {
          "line": 97,
          "text": "    return session"
        },
        {
          "line": 98,
          "text": "  } catch(error) {"
        },
        {
          "line": 99,
          "text": "    if(token!==generation)return null"
        },
        {
          "line": 100,
          "text": "    update({busy:false,error:errorText(error)})"
        },
        {
          "line": 101,
          "text": "    throw error"
        },
        {
          "line": 102,
          "text": "  }"
        },
        {
          "line": 103,
          "text": "}"
        },
        {
          "line": 104,
          "text": ""
        },
        {
          "line": 105,
          "text": "export async function refreshRuntimeFrames():Promise<void> {"
        },
        {
          "line": 106,
          "text": "  const session=state.session"
        },
        {
          "line": 107,
          "text": "  if(!session)return"
        }
      ]
    },
