        {
          "line": 35,
          "text": "export interface RuntimeClientState {"
        },
        {
          "line": 36,
          "text": "  session:RuntimeSession|null; frames:RuntimeFrame[]; projectRevision:number|null;"
        },
        {
          "line": 37,
          "text": "  busy:boolean; error:string|null; connection:'idle'|'connected'|'reconnecting';"
        },
        {
          "line": 38,
          "text": "}"
        },
        {
          "line": 39,
          "text": "const EMPTY:RuntimeClientState = {session:null,frames:[],projectRevision:null,busy:false,error:null,connection:'idle'}"
        },
        {
          "line": 40,
          "text": "let state:RuntimeClientState = EMPTY"
        },
        {
          "line": 41,
          "text": "let generation=0"
        },
        {
          "line": 42,
          "text": "let frameCursor=-1"
        },
        {
          "line": 43,
          "text": "let lifecycleRevision=0"
        },
        {
          "line": 44,
          "text": "let refreshSerial=0"
        },
        {
          "line": 45,
          "text": "let appliedRefresh=0"
        },
        {
          "line": 46,
          "text": "let timer:ReturnType<typeof setTimeout>|null=null"
        },
        {
          "line": 47,
          "text": "let polling=false"
        },
        {
          "line": 48,
          "text": "const listeners = new Set<()=>void>()"
        },
        {
          "line": 49,
          "text": "export function subscribeRuntime(listener:()=>void) {listeners.add(listener);return ()=>{listeners.delete(listener)}}"
        },
        {
          "line": 50,
          "text": "export function runtimeState() {return state}"
        },
        {
          "line": 51,
          "text": "function update(patch:Partial<RuntimeClientState>) {state={...state,...patch};listeners.forEach(f=>f())}"
        },
        {
          "line": 52,
          "text": "function errorText(error:unknown) {return error instanceof Error?error.message:String(error)}"
        },
        {
          "line": 53,
          "text": "export function stopRuntimePolling() {polling=false;if(timer!==null)clearTimeout(timer);timer=null}"
        },
        {
          "line": 54,
          "text": "export function resetRuntimeClient() {stopRuntimePolling();generation++;frameCursor=-1;state=EMPTY;listeners.forEach(f=>f())}"
        }
      ]
    },
    {
      "path": "/mnt/lv/home/litianyu/mycode/dcdtuni/.codex-tmp/goal-20261005/integration/src/frontend/react/src/liquid/liquidRuntimeClient.ts",
