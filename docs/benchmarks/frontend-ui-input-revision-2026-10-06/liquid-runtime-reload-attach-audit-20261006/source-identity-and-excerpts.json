        {
          "line": 228,
          "text": "/**"
        },
        {
          "line": 229,
          "text": " * Fetch the results of a previous solve without running one."
        },
        {
          "line": 230,
          "text": " * Selectors may validate a document before it replaces the current result."
        },
        {
          "line": 231,
          "text": " */"
        },
        {
          "line": 232,
          "text": "export async function fetchLiquidResults("
        },
        {
          "line": 233,
          "text": "  runName?: string,"
        },
        {
          "line": 234,
          "text": "  acceptResult?: (data: unknown) => boolean,"
        },
        {
          "line": 235,
          "text": "): Promise<unknown | null> {"
        },
        {
          "line": 236,
          "text": "  const requestGeneration = ++resultRequestGeneration"
        },
        {
          "line": 237,
          "text": "  const url = runName"
        },
        {
          "line": 238,
          "text": "    ? `/api/liquid/results?run=${encodeURIComponent(runName)}`"
        },
        {
          "line": 239,
          "text": "    : '/api/liquid/results'"
        },
        {
          "line": 240,
          "text": "  try {"
        },
        {
          "line": 241,
          "text": "    const resp = await fetch(url)"
        },
        {
          "line": 242,
          "text": "    if (!resp.ok) return null"
        },
        {
          "line": 243,
          "text": "    const data: unknown = await resp.json()"
        },
        {
          "line": 244,
          "text": "    if (requestGeneration !== resultRequestGeneration) return null"
        },
        {
          "line": 245,
          "text": "    if (acceptResult && !acceptResult(data)) return null"
        },
        {
          "line": 246,
          "text": "    set({ results: data })"
        },
        {
          "line": 247,
          "text": "    return data"
        },
        {
          "line": 248,
          "text": "  } catch {"
        },
        {
          "line": 249,
          "text": "    return null"
        },
        {
          "line": 250,
          "text": "  }"
        }
      ]
    },
