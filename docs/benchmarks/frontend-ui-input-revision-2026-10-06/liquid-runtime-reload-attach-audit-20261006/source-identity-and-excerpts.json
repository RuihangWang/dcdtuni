          "text": "function completedRun(): string | null {"
        },
        {
          "line": 26,
          "text": "  const session = runtime.runtimeState().session"
        },
        {
          "line": 27,
          "text": "  return session?.status === 'completed' ? session.run_id : null"
        },
        {
          "line": 28,
          "text": "}"
        },
        {
          "line": 29,
          "text": ""
        },
        {
          "line": 30,
          "text": "function onRuntime() {"
        },
        {
          "line": 31,
          "text": "  const run = completedRun()"
        },
        {
          "line": 32,
          "text": "  if (!run || run === followed) return"
        },
        {
          "line": 33,
          "text": "  followed = run"
        },
        {
          "line": 34,
          "text": "  const dir = `run-${run}`"
        },
        {
          "line": 35,
          "text": "  const selected = selectedLiquidRun()"
        },
        {
          "line": 36,
          "text": "  if (selected === '' || selected === dir) void fetchLiquidResults(dir)"
        },
        {
          "line": 37,
          "text": "}"
        }
      ]
    }
