        {
          "line": 59,
          "text": "  async function choose(value: string) {"
        },
        {
          "line": 60,
          "text": "    // Keep the displayed record paired with the last valid results while the"
        },
        {
          "line": 61,
          "text": "    // requested record is being read. Reject malformed documents before the"
        },
        {
          "line": 62,
          "text": "    // shared session publishes them, so a failed read cannot disturb playback."
        },
        {
          "line": 63,
          "text": "    setBusy(true)"
        },
        {
          "line": 64,
          "text": "    setStatus(null)"
        },
        {
          "line": 65,
          "text": "    const raw = await fetchLiquidResults(value || undefined, (data) => !!parseLiquidResults(data))"
        },
        {
          "line": 66,
          "text": "    if (parseLiquidResults(raw)) {"
        },
        {
          "line": 67,
          "text": "      setRun(value)"
        },
        {
          "line": 68,
          "text": "      setSelectedLiquidRun(value)"
        },
        {
          "line": 69,
          "text": "      setStatus(null)"
        },
        {
          "line": 70,
          "text": "    } else {"
        },
        {
          "line": 71,
          "text": "      setStatus(t('lsm.result_read_failed'))"
        },
        {
          "line": 72,
          "text": "    }"
        },
        {
          "line": 73,
          "text": "    setBusy(false)"
        },
        {
          "line": 74,
          "text": "  }"
        }
      ]
    },
