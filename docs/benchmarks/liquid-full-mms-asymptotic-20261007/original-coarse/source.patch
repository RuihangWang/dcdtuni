+"""Explicit synthetic MMS input. No source is generated by a product residual.
+Only v4 opt-in instances append forcing parameters; normal layouts are unchanged.
+"""
+from __future__ import annotations
+from typing import Annotated,Literal
+import hashlib,json
+from pydantic import Field,model_validator
+from .liquidrun_schema import StrictModel,Number,Identifier,Hash
+from .parameters import resolve_parameter_pack
+
+MAX_BENCHMARK_BYTES=32*1024*1024
+MAX_BENCHMARK_SCALARS=4_000_000
+Rows=Annotated[list[Identifier],Field(max_length=4000)]
+Numbers=Annotated[list[Number],Field(max_length=10000)]
+
+class Vector(StrictModel):
+    ids:Rows
+    values:Numbers
+    @model_validator(mode='after')
+    def shape(self):
+        if len(self.ids)!=len(self.values) or len(set(self.ids))!=len(self.ids):
+            raise ValueError('unique IDs and exact vector coverage required')
+        return self
+
+class Matrix(StrictModel):
+    ids:Rows
+    values:Annotated[list[Numbers],Field(max_length=4000)]
+    @model_validator(mode='after')
+    def shape(self):
+        if len(self.ids)!=len(self.values) or len(set(self.ids))!=len(self.ids):
+            raise ValueError('unique IDs and exact matrix coverage required')
+        return self
+
+class Storage(StrictModel):
+    water_temperature_K:Vector
+    solid_temperature_K:Vector
+    hx_secondary_K:Vector
+    hx_primary_K:Vector
+
+class Initial(Storage):
+    node_pressure_Pa:Vector
+    flow_kg_s:Vector
+    node_temperature_K:Vector
+
+class Sources(StrictModel):
+    momentum_Pa:Matrix
+    water_W:Matrix
+    solid_W:Matrix
+    hx_secondary_W:Matrix
+    hx_primary_W:Matrix
+
+class BenchmarkUnits(StrictModel):
+    pressure:Literal['Pa']
+    temperature:Literal['K']
+    mass_flow:Literal['kg/s']
+    power:Literal['W']
+    time:Literal['s']
+    temperature_rate:Literal['K/s']
+
+class ManufacturedBenchmark(StrictModel):
+    format:Literal['dcdtuni-manufactured-benchmark']
+    version:Literal[1]
+    provenance:Literal['synthetic-research']
+    formula_id:Identifier
+    source_reference:Identifier
+    graph_layout_sha256:Hash
+    source_sha256:Hash
+    units:BenchmarkUnits
+    sampling:Literal['endpoint_hold']
+    times_s:Numbers
+    sources:Sources
+    initial_state:Initial
+    initial_temperature_rate:Storage
+    flow_signs:Vector
+    @model_validator(mode='after')
+    def finite_identity(self):
+        value=self.model_dump(mode='json')
+        digest=value.pop('source_sha256')
+        if canonical_digest(value)!=digest:
+            raise ValueError('manufactured source SHA mismatch')
+        if sum(len(row) for field in self.sources for row in field[1].values)>MAX_BENCHMARK_SCALARS:
+            raise ValueError('manufactured source scalar cap exceeded')
+        return self
+
+def canonical_digest(value):
+    return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()).hexdigest()
+
+def graph_layout(view):
+    raw=resolve_parameter_pack(view)
+    return {'nodes':[{'id':n['id'],'type':n['type']} for n in raw['nodes']],
+            'edges':[{'id':e['id'],'type':e['type'],'from':e['from'],'to':e['to'],
+                      'n_cells':e['params'].get('n_cells') if e['type']=='pipe' else None} for e in raw['edges']]}
+
+def layout_ids(view):
+    raw=resolve_parameter_pack(view);edges=raw['edges']
+    return {'nodes':[n['id'] for n in raw['nodes']],'edges':[e['id'] for e in edges],
+            'water':[f"{e['id']}/cell/{i}" for e in edges if e['type']=='pipe' for i in range(e['params']['n_cells'])],
+            'solid':[e['id'] for e in edges if e['type']=='cold_plate'],
+            'hx':[e['id'] for e in edges if e['type']=='heat_exchanger']}
+
+def validate_contract(benchmark,manifest,view):
+    if manifest.schemaVersion!=4 or manifest.analysis.mode!='transient' or manifest.analysis.initialization!='consistent':
+        raise ValueError('manufactured benchmark needs v4 transient/consistent and explicit manufactured initial state')
+    if len(json.dumps(benchmark.model_dump(mode='json'),allow_nan=False).encode())>MAX_BENCHMARK_BYTES:
+        raise ValueError('manufactured benchmark byte cap exceeded')
+    if benchmark.graph_layout_sha256!=canonical_digest(graph_layout(view)):
+        raise ValueError('manufactured graph/storage layout SHA mismatch')
+    expected=[i*manifest.time.dt_s for i in range(manifest.time.N_t)]
+    if benchmark.times_s!=expected:
+        raise ValueError('manufactured source times must exactly equal the admitted sample grid')
+    raw=resolve_parameter_pack(view)
+    for e in raw['edges']:
+        if e['type']=='valve':
+            opening=e['params']['opening']
+            if any(v<=0 for v in (opening if isinstance(opening,list) else [opening])):
+                raise ValueError('manufactured benchmark supports open valves only')
+    for e in manifest.edges:
+        if (getattr(e.params,'mode',None) in ('flow','setpoint') or
+            getattr(e.params,'heat_mode',None)=='temperature_rise'):
+            raise ValueError('manufactured benchmark does not support held/rise endpoint modes')
+    ids=layout_ids(view)
+    smap={'momentum_Pa':'edges','water_W':'water','solid_W':'solid','hx_secondary_W':'hx','hx_primary_W':'hx'}
+    imap={'node_pressure_Pa':'nodes','flow_kg_s':'edges','node_temperature_K':'nodes',
+          'water_temperature_K':'water','solid_temperature_K':'solid','hx_secondary_K':'hx','hx_primary_K':'hx'}
+    def coverage(record,expected,name):
+        if set(record.ids)!=set(expected) or len(record.ids)!=len(expected):
+            raise ValueError(name+' must cover every matching graph/storage ID exactly once')
+    for name,key in smap.items():
+        record=getattr(benchmark.sources,name);coverage(record,ids[key],name)
+        if any(len(row)!=manifest.time.N_t for row in record.values):
+            raise ValueError(name+' rows must have exactly N_t samples')
+    for name,key in imap.items():
+        record=getattr(benchmark.initial_state,name);coverage(record,ids[key],name)
+        if name.endswith('_K') and any(v<=0 for v in record.values):
+            raise ValueError('manufactured initial temperatures must be positive Kelvin')
+    for name,key in imap.items():
+        if name in type(benchmark.initial_temperature_rate).model_fields:
+            coverage(getattr(benchmark.initial_temperature_rate,name),ids[key],name+' derivative')
+    coverage(benchmark.flow_signs,ids['edges'],'flow_signs')
+    signs=dict(zip(benchmark.flow_signs.ids,benchmark.flow_signs.values))
+    if any(v not in (-1.,1.) for v in signs.values()):
+        raise ValueError('manufactured flow signs must be +/-1')
+    if any(v*signs[k]<=1e-8 for k,v in zip(benchmark.initial_state.flow_kg_s.ids,benchmark.initial_state.flow_kg_s.values)):
+        raise ValueError('manufactured initial flows must stay inside the declared nonzero sign regime')
+
+def compiled_ids(eq):
+    g=eq.graph
+    water=[]
+    if g.pipe_indices is not None:
+        for e,a,b in zip(g.pipe_indices.edge_ids.tolist(),g.pipe_indices.cell_start.tolist(),g.pipe_indices.cell_end.tolist()):
+            water.extend(f'{g.edge_str_ids[e]}/cell/{i}' for i in range(b-a))
+    return {'nodes':g.node_ids,'edges':g.edge_str_ids,'water':water,
+            'solid':[g.edge_str_ids[i] for i in eq._ids['cp'].tolist()],
+            'hx':[g.edge_str_ids[i] for i in eq._ids['hx'].tolist()]}
+
+SOURCE_FIELDS={'momentum_Pa':'mms_momentum_Pa','water_W':'mms_water_W','solid_W':'mms_solid_W',
+               'hx_secondary_W':'mms_hx_secondary_W','hx_primary_W':'mms_hx_primary_W'}
+STATE_FIELDS={'node_pressure_Pa':('pressure_free','nodes'),'flow_kg_s':('flow','edges'),
+              'node_temperature_K':('node_temperature','nodes'),'water_temperature_K':('water_temperature','water'),
+              'solid_temperature_K':('solid_temperature','solid'),'hx_secondary_K':('hx_secondary_temperature','hx'),
+              'hx_primary_K':('primary_return_temperature','hx')}
+
+def bind(eq,benchmark):
+    import torch
+    ids=compiled_ids(eq);mapping={'momentum_Pa':'edges','water_W':'water','solid_W':'solid','hx_secondary_W':'hx','hx_primary_W':'hx'}
+    schedules={}
+    for source,key in mapping.items():
+        record=getattr(benchmark.sources,source);rows=dict(zip(record.ids,record.values))
+        schedules[SOURCE_FIELDS[source]]=torch.tensor([rows[i] for i in ids[key]],dtype=eq.dtype,device=eq.device).reshape(len(ids[key]),len(benchmark.times_s))
+    sign=dict(zip(benchmark.flow_signs.ids,benchmark.flow_signs.values))
+    eq.manufactured_signs=eq.graph.bc_P.new_tensor([sign[i] for i in ids['edges']])
+    return schedules
+
+def initial_vectors(eq,benchmark,theta):
+    import torch
+    ids=compiled_ids(eq);y=theta.new_empty(eq.size);d=torch.zeros_like(y)
+    for name,(state,key) in STATE_FIELDS.items():
+        record=getattr(benchmark.initial_state,name);rows=dict(zip(record.ids,record.values))
+        vector=theta.new_tensor([rows[i] for i in ids[key]])
+        if state=='pressure_free':
+            bc=eq._theta(theta)['pressure_bc']
+            if not torch.equal(vector[eq._bc_mask],bc[eq._bc_mask]):
+                raise ValueError('manufactured initial pressure datum mismatch')
+            vector=vector[eq._free]
+        y[eq.state_layout[state]]=vector
+        if name in type(benchmark.initial_temperature_rate).model_fields:
+            r=getattr(benchmark.initial_temperature_rate,name);vals=dict(zip(r.ids,r.values))
+            d[eq.state_layout[state]]=theta.new_tensor([vals[i] for i in ids[key]])
+    return y,d
