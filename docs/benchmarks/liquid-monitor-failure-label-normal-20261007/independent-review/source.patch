+/** Current-session failure text only; request/connection errors retain their
+ * separate state and caller precedence. Never serialize or render raw objects. */
+export function runtimeFailureMessage(session:RuntimeSession|null,fallback:string):string|null {
+  if(session?.status!=='failed')return null
+  const error:unknown=session.error
+  if(typeof error==='string')return error.trim()?error:fallback
+  if(error===null||typeof error!=='object')return fallback
+  const value=error as Partial<RuntimeFailure>
+  return typeof value.type==='string'&&value.type.trim()&&
+    typeof value.message==='string'&&value.message.trim()&&
+    typeof value.last_successful_seq==='number'&&Number.isSafeInteger(value.last_successful_seq)&&value.last_successful_seq>=0
+      ?value.message:fallback
+}
