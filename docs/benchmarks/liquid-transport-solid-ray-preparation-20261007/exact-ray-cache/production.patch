+def _ray_triangle_distances_batch(np, origin: Vec3, direction: Vec3, v0, edge1, edge2):
+    """Component-order Moller-Trumbore for one bounded finite batch."""
+    px = direction[1] * edge2[:, 2] - direction[2] * edge2[:, 1]
+    py = direction[2] * edge2[:, 0] - direction[0] * edge2[:, 2]
+    pz = direction[0] * edge2[:, 1] - direction[1] * edge2[:, 0]
+    det = (edge1[:, 0] * px + edge1[:, 1] * py) + edge1[:, 2] * pz
+    keep = np.abs(det) > _GEOM_EPS
+    if not keep.any():
+        return np.empty(0, dtype=np.float64)
+    inv_det = 1.0 / det[keep]
+    v0, edge1, edge2, px, py, pz = v0[keep], edge1[keep], edge2[keep], px[keep], py[keep], pz[keep]
+    tx, ty, tz = origin[0] - v0[:, 0], origin[1] - v0[:, 1], origin[2] - v0[:, 2]
+    u = ((tx * px + ty * py) + tz * pz) * inv_det
+    keep = ~((u < 0.0) | (u > 1.0))
+    if not keep.any():
+        return np.empty(0, dtype=np.float64)
+    tx, ty, tz, edge1, edge2, inv_det, u = tx[keep], ty[keep], tz[keep], edge1[keep], edge2[keep], inv_det[keep], u[keep]
+    qx = ty * edge1[:, 2] - tz * edge1[:, 1]
+    qy = tz * edge1[:, 0] - tx * edge1[:, 2]
+    qz = tx * edge1[:, 1] - ty * edge1[:, 0]
+    v = ((direction[0] * qx + direction[1] * qy) + direction[2] * qz) * inv_det
+    keep = ~((v < 0.0) | (u + v > 1.0))
+    if not keep.any():
+        return np.empty(0, dtype=np.float64)
+    edge2, qx, qy, qz, inv_det = edge2[keep], qx[keep], qy[keep], qz[keep], inv_det[keep]
+    distance = ((edge2[:, 0] * qx + edge2[:, 1] * qy) + edge2[:, 2] * qz) * inv_det
+    return distance[~(distance <= _GEOM_EPS)]
+
