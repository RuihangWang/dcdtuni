+@dataclass(frozen=True)
+class _SceneRayCache:
+    """Immutable rows/arrays owned by one seed-generation epoch, never global.
+
+    Packed binary64 arrays have immutable bytes backing, retaining all triangles,
+    surface labels and original order. Unsupported inputs keep the scalar path.
+    """
+    rows: Tuple[SceneTriangle, ...]
+    _np: Any = None
+    _v0: Any = None
+    _edge1: Any = None
+    _edge2: Any = None
+    _surface_ids: Any = None
+    _surface_refs: Tuple[SurfaceRef, ...] = ()
+
+    def __iter__(self):
+        return iter(self.rows)
+
+    def nearest(self, center: Vec3, direction: Vec3,
+                ignored: Set[SurfaceRef]) -> Optional[float]:
+        np = self._np
+        if np is None or any(type(v) is not float or not math.isfinite(v)
+                             for vec in (center, direction) for v in vec):
+            raise ValueError("scalar ray input required")
+        origin = _vec_add(center, _vec_scale(direction, _RAY_START_EPS))
+        if not all(math.isfinite(v) for v in origin):
+            raise ValueError("scalar ray origin required")
+        ignored_ids = [i for i, ref in enumerate(self._surface_refs) if ref in ignored]
+        nearest: Optional[float] = None
+        # Independent component ufuncs preserve scalar operation order:
+        # no einsum/dot reduction/FMA/float32 or geometric pruning.
+        with np.errstate(over="raise", divide="raise", invalid="raise", under="ignore"):
+            for start in range(0, len(self.rows), _RAY_BATCH_TRIANGLES):
+                stop = min(start + _RAY_BATCH_TRIANGLES, len(self.rows))
+                keep = np.ones(stop - start, dtype=np.bool_)
+                for surface_id in ignored_ids:
+                    keep &= self._surface_ids[start:stop] != surface_id
+                if not keep.any():
+                    continue
+                distances = _ray_triangle_distances_batch(
+                    np, origin, direction, self._v0[start:stop][keep],
+                    self._edge1[start:stop][keep], self._edge2[start:stop][keep])
+                if distances.size:
+                    # Accepted distances + positive start epsilon cannot be
+                    # signed zero; equal minima have identical binary64 bits.
+                    clearance = float(np.min(distances + _RAY_START_EPS))
+                    if nearest is None or clearance < nearest:
+                        nearest = clearance
+        return nearest
+
+
+def _make_scene_ray_cache(scene_triangles: Iterable[SceneTriangle]) -> _SceneRayCache:
+    """Freeze parsed rows once per call; no cross-scene/cross-run cache."""
+    rows = tuple(scene_triangles)
+    try:
+        # Do not sanitize exotic/nonfinite numeric carriers into valid geometry.
+        for filename, solid_name, triangle in rows:
+            if type(filename) is not str or type(solid_name) is not str or len(triangle) != 3:
+                return _SceneRayCache(rows)
+            for vertex in triangle:
+                if len(vertex) != 3 or any(type(v) is not float or not math.isfinite(v) for v in vertex):
+                    return _SceneRayCache(rows)
+        import numpy as np
+        frozen = tuple((filename, solid_name, tuple(tuple(v) for v in triangle))
+                       for filename, solid_name, triangle in rows)
+        # frombuffer(bytes) prevents re-enabling array writeability and keeps
+        # mutable caller vertices/owners out of the accelerated epoch.
+        def immutable(array):
+            return np.frombuffer(array.tobytes(), dtype=array.dtype).reshape(array.shape)
+        vertices = np.asarray([row[2] for row in frozen], dtype=np.float64).reshape((-1, 3, 3))
+        with np.errstate(over="raise", divide="raise", invalid="raise", under="ignore"):
+            v0 = immutable(vertices[:, 0, :])
+            edge1 = immutable(vertices[:, 1, :] - vertices[:, 0, :])
+            edge2 = immutable(vertices[:, 2, :] - vertices[:, 0, :])
+        refs: Dict[SurfaceRef, int] = {}
+        ids = []
+        for filename, solid_name, _ in frozen:
+            ref = (filename, solid_name)
+            if ref not in refs:
+                refs[ref] = len(refs)
+            ids.append(refs[ref])
+        return _SceneRayCache(frozen, np, v0, edge1, edge2,
+                              immutable(np.asarray(ids, dtype=np.int64)), tuple(refs))
+    except Exception:
+        # Missing NumPy, allocation/conversion/overflow errors fall back to
+        # identical scalar rows rather than bypassing any seed guard.
+        return _SceneRayCache(rows)
+
