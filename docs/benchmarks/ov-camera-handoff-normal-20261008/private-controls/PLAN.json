{
  "schema": "dcdtuni.ov-camera-handoff-private/v1",
  "targets": [
    "src/frontend/react/src/renderer/RendererControl.tsx",
    "src/frontend/react/src/renderer/ovProtocol.ts",
    "src/frontend/omniverse/cfd_demo/kit/extensions/dc.cfd_bridge/dc/cfd_bridge/extension.py",
    "src/frontend/react/test/cameraPurposeProtocol.test.ts",
    "src/frontend/react/test/cameraReadbackMounted.test.ts",
    "src/frontend/omniverse/cfd_demo/tests/test_camera_handoff_purpose.py",
    "src/frontend/react/test/ovReturnDeadline.test.tsx",
    "src/frontend/omniverse/cfd_demo/tests/test_render_command_routing.py",
    "src/frontend/omniverse/cfd_demo/tests/test_dataset_scene_race.py",
    "src/frontend/omniverse/cfd_demo/tests/test_native_grid_ack_json_transport.py"
  ],
  "limits": {
    "CPU": [
      36,
      37
    ],
    "CUDA_VISIBLE_DEVICES": "",
    "perControlTimeoutSeconds": 60,
    "frontendWorkers": 2
  },
  "actualProductDeadlinesSeconds": {
    "sameProjectResync": 3,
    "returnNondiagnostic": 8,
    "returnDiagnostic": 3
  },
  "selector": {
    "command": "getViewState",
    "keys": [
      "requestId",
      "purpose"
    ],
    "purpose": "camera-handoff",
    "unknownPurpose": "refused before read/proof",
    "response": "actual live camera and original scene identity; no gridDisplay"
  },
  "held": [
    "nativeGrid source and native proof",
    "full ordinary getViewState receipt",
    "outbound readiness/recovery",
    "all timeouts/caps",
    "normal sources/Git/services/browser",
    "ACK quiet batching and native freshness prefix; only final wire predicate widened"
  ],
  "nextRootAcceptance": [
    "independent replay/full source review",
    "normal exact nine targets apply/types/productionbuild",
    "only owned debug via normal startup script restart",
    "actual Windows IAB sameUID casePath resync stays OV within original3s; real view identity",
    "Three-OV-Three within original8s; late/stale refuses",
    "ordinary grid query keeps full native receipt; no new encoded pixel claim"
  ],
  "wire": {
    "predicate": "nativeGeometry present OR type(payload.get('view')) is dict",
    "realView": "wholeJSON preserves explicit null, numeric zero/positive and empty/nonempty selection",
    "noView": "original plain unless native receipt exists",
    "failedEncoding": "no plain fallback, continue next ACK",
    "receiverRepair": false
  }
}
