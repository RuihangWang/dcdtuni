+# Separate bounded trace for post-camera pending returns and lowering receipts.
+# It observes only values already read by the original code; no new authority.
+_NATIVE_GRID_PENDING_DIAGNOSTICS = os.environ.get('DC_CFD_NATIVE_GRID_PENDING_DIAGNOSTICS') == 'grid-pending-v1'
+_NATIVE_GRID_PENDING_LIMIT = 8
+_NATIVE_GRID_PENDING_SEEN = set()
+
+
+def _native_grid_pending_values(sample):
+    # Exclude the native TimeCode object. Its already-read value is in owner.
+    return {k:sample[k] for k in ('owner','resolution','full','world','view',
+        'transform','projection','maps','frame','image')}
+
+
+def _native_grid_pending_diagnostic(domain, stage, phase, reason, frames=None,
+                                    samples=None, serial=None, categories=()):
+    """Default OFF, eight rows independent of cohort exhaustion; no getters."""
+    if (not _NATIVE_GRID_PENDING_DIAGNOSTICS
+            or len(_NATIVE_GRID_PENDING_SEEN) >= _NATIVE_GRID_PENDING_LIMIT):
+        return
+    try:
+        reasons = {'native-viewport-unavailable','native-viewport-owner-not-current',
+            'native-camera-frame-not-current','native-projection-frame-not-current',
+            'native-camera-changed-during-sample','native-observation-changed-during-sample',
+            'native-public-viewport-observation-unavailable','viewport-frame-not-current',
+            'native-grid-view-not-current','native-observation-changed-during-lowering',
+            'stream-layout-unresolved','stream-layout-degenerate'}
+        if (domain not in ('sampler','lowering') or phase not in ('pending','unsupported')
+                or type(stage) is not str or len(stage) > 80 or reason not in reasons):
+            return
+        changed = []
+        if type(samples) is dict and 'first' in samples and 'final' in samples:
+            first, final = samples['first'], samples['final']
+            for key in ('owner','resolution','full','world','view','transform','projection','maps','image'):
+                if first[key] != final[key]:
+                    changed.append(key)
+            for key in ('frameNumber','resolution','view','projection'):
+                if first['frame'][key] != final['frame'][key]:
+                    changed.append('frame.' + key)
+        # Static branch categories do not claim which short-circuit term ran.
+        branch = {'first-authored-camera':'first-authored-view-or-missing-camera',
+            'first-camera-projection':'first-authored-conformed-image-projection',
+            'final-authored-view':'final-authored-view-or-conformed-image-projection',
+            'final-source-owner-view-fences':'first-final-values-or-closing-owner-view-source'}
+        labels = list(categories)
+        if stage in branch:
+            labels.append(branch[stage])
+        if any(type(x) is not str or len(x) > 100 for x in labels):
+            return
+        request = _NATIVE_GRID_COHORT_REQUEST.get()
+        if serial is None and request:
+            serial = request['requestSerial']
+        if serial is not None and (type(serial) is not int or not 0 <= serial <= 9007199254740991):
+            return
+        digest = lambda value: hashlib.sha256(value.encode('utf-8')).hexdigest()
+        record = {'schema':'dcdtuni.native-grid-pending-diagnostic/v1',
+            'sequence':len(_NATIVE_GRID_PENDING_SEEN)+1,'domain':domain,'stage':stage,
+            'phase':phase,'reason':reason,'requestSerial':serial,
+            'requestViewTokenSHA256':digest(request['viewToken']) if request else None,
+            'requestContextTokenSHA256':digest(request['contextToken']) if request else None,
+            'frames':frames or {},'comparisonCategories':labels,'changedSampleFields':changed,
+            'additionalNativeReads':False,'gridPixelVerified':False,'diagnosticAuthority':False}
+        key = (domain,stage,phase,reason,tuple(labels),tuple(changed))
+        if key in _NATIVE_GRID_PENDING_SEEN:
+            return
+        encoded = json.dumps(record,sort_keys=True,separators=(',',':'),allow_nan=False)
+        if len(encoded.encode('utf-8')) > 4096:
+            return
+        # Reserve before sink: a failed sink cannot bypass the module cap.
+        _NATIVE_GRID_PENDING_SEEN.add(key)
+        print('[dc.cfd_bridge] native-grid-pending-diagnostic ' + encoded)
+    except Exception:
+        pass  # Diagnostics cannot alter the original return or exception path.
+
+
+def _native_grid_pending_frame(owner, resolution, full, frame):
+    return {'owner':list(owner),'resolution':list(resolution),'fullResolution':list(full),
+            'frameNumber':frame['frameNumber']}
+
