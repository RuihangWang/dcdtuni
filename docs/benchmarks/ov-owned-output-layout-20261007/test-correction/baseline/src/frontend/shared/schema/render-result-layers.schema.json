{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dcdtuni.render-result-layers/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/packetV1"
    },
    {
      "$ref": "#/$defs/packetV2"
    },
    {
      "$ref": "#/$defs/packetV3"
    },
    {
      "$ref": "#/$defs/packetV4"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectUid",
        "projectContentSha256",
        "cfdrunSha256",
        "meshReceiptSha256",
        "meshQuality",
        "run"
      ],
      "properties": {
        "projectUid": {
          "type": "string",
          "minLength": 1
        },
        "projectContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cfdrunSha256": {
          "$ref": "#/$defs/sha256"
        },
        "meshReceiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "meshQuality": {
          "enum": [
            "accepted",
            "diagnostic"
          ]
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uid",
                "receiptSha256"
              ],
              "properties": {
                "uid": {
                  "type": "string",
                  "minLength": 1
                },
                "receiptSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upAxis",
        "metersPerUnit",
        "handedness"
      ],
      "properties": {
        "upAxis": {
          "const": "Y"
        },
        "metersPerUnit": {
          "const": 1
        },
        "handedness": {
          "const": "right"
        }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sourceFaceUids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "range",
        "opacity"
      ],
      "properties": {
        "palette": {
          "enum": [
            "coolwarm",
            "jet",
            "viridis"
          ]
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "meshEdges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "meshPatchName",
        "sourceFaceUids",
        "positions",
        "indices",
        "opacity"
      ],
      "properties": {
        "kind": {
          "const": "meshEdges"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "meshPatchName": {
          "type": "string",
          "minLength": 1
        },
        "sourceFaceUids": {
          "$ref": "#/$defs/sourceFaceUids"
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "surfaceField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "meshPatchName",
        "sourceFaceUids",
        "positions",
        "indices",
        "values",
        "field",
        "lut"
      ],
      "properties": {
        "kind": {
          "const": "surfaceField"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "meshPatchName": {
          "type": "string",
          "minLength": 1
        },
        "sourceFaceUids": {
          "$ref": "#/$defs/sourceFaceUids"
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "lut": {
          "$ref": "#/$defs/lut"
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "sourceSliceUid",
        "originMeters",
        "normal",
        "positions",
        "indices",
        "values",
        "field",
        "lut"
      ],
      "properties": {
        "kind": {
          "const": "slice"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "sourceSliceUid": {
          "type": "string",
          "minLength": 1
        },
        "originMeters": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "lut": {
          "$ref": "#/$defs/lut"
        }
      }
    },
    "streamline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "sourceSeedUid",
        "lines",
        "field",
        "lut",
        "tubeRadiusMeters"
      ],
      "properties": {
        "kind": {
          "const": "streamline"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "sourceSeedUid": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/streamlineLine"
          }
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "lut": {
          "$ref": "#/$defs/lut"
        },
        "tubeRadiusMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "streamlineLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positions",
        "values"
      ],
      "properties": {
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        }
      }
    },
    "meshEdgesV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "meshPatchName",
        "boundaryProvenance",
        "positions",
        "indices",
        "opacity"
      ],
      "properties": {
        "kind": {
          "const": "meshEdges"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "meshPatchName": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boundaryProvenance": {
          "$ref": "#/$defs/nativeBoundaryProvenance"
        }
      }
    },
    "surfaceFieldV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "meshPatchName",
        "boundaryProvenance",
        "positions",
        "indices",
        "values",
        "field",
        "lut"
      ],
      "properties": {
        "kind": {
          "const": "surfaceField"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "meshPatchName": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "lut": {
          "$ref": "#/$defs/lut"
        },
        "boundaryProvenance": {
          "$ref": "#/$defs/nativeBoundaryProvenance"
        }
      }
    },
    "regionInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEntityUid",
        "sourceRegionUid",
        "sourceFacetUidPrefix",
        "sourceRegionSha256",
        "sourceFacetCount"
      ],
      "properties": {
        "sourceEntityUid": {
          "type": "string",
          "minLength": 1
        },
        "sourceRegionUid": {
          "type": "string",
          "minLength": 1
        },
        "sourceFacetUidPrefix": {
          "type": "string",
          "minLength": 1
        },
        "sourceRegionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceFacetCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePatchRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingKind",
        "rank",
        "patchIndex",
        "startFace",
        "nativePatchName",
        "nFaces",
        "boundarySha256",
        "sourceRegions"
      ],
      "properties": {
        "bindingKind": {
          "enum": [
            "regionFacetInventory",
            "meshBoundaryOnly"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "patchIndex": {
          "type": "integer",
          "minimum": 0
        },
        "startFace": {
          "type": "integer",
          "minimum": 0
        },
        "nativePatchName": {
          "type": "string",
          "minLength": 1
        },
        "nFaces": {
          "type": "integer",
          "minimum": 1
        },
        "boundarySha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regionInventory"
          }
        }
      }
    },
    "nativeBoundaryProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "patchRanges"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.native-boundary-provenance/v1"
        },
        "patchRanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePatchRange"
          }
        }
      }
    },
    "packetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "source",
        "coordinateSystem",
        "timeSeconds",
        "layers"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.render-result-layers/v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "coordinateSystem": {
          "$ref": "#/$defs/coordinateSystem"
        },
        "timeSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "layers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/meshEdges"
              },
              {
                "$ref": "#/$defs/surfaceField"
              },
              {
                "$ref": "#/$defs/slice"
              },
              {
                "$ref": "#/$defs/streamline"
              }
            ]
          }
        }
      }
    },
    "packetV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "source",
        "coordinateSystem",
        "timeSeconds",
        "layers",
        "runConvergence"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.render-result-layers/v2"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "coordinateSystem": {
          "$ref": "#/$defs/coordinateSystem"
        },
        "timeSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "layers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/meshEdgesV2"
              },
              {
                "$ref": "#/$defs/surfaceFieldV2"
              },
              {
                "$ref": "#/$defs/slice"
              },
              {
                "$ref": "#/$defs/streamline"
              }
            ]
          }
        },
        "runConvergence": {
          "$ref": "#/$defs/runConvergence"
        }
      }
    },
    "runConvergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "receiptSha256"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "CONVERGED",
            "NOT_CONVERGED",
            "INCONCLUSIVE",
            "TRANSIENT_COMPLETED",
            "TRANSIENT_INCOMPLETE"
          ]
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commonVolumeGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "field",
        "dimensions",
        "originMeters",
        "spacingMeters",
        "layout",
        "sentinel",
        "scalarRange",
        "payloadSha256",
        "payloadBytes",
        "scalarOffset",
        "validityMask"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.common-volume-grid/v2"
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 16,
            "maximum": 512
          }
        },
        "originMeters": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "spacingMeters": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "layout": {
          "const": "x-fastest-point-nodes"
        },
        "sentinel": {
          "type": "number",
          "exclusiveMaximum": 0
        },
        "scalarRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "payloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 672137216
        },
        "scalarOffset": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1048580
        },
        "validityMask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "offset",
            "byteCount",
            "sha256"
          ],
          "properties": {
            "encoding": {
              "const": "uint8-01"
            },
            "offset": {
              "type": "integer",
              "minimum": 4,
              "maximum": 672137216
            },
            "byteCount": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 134217728
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "commonVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactName",
        "grid",
        "field",
        "lut",
        "visible"
      ],
      "properties": {
        "artifactName": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}\\.volume$"
        },
        "grid": {
          "$ref": "#/$defs/commonVolumeGrid"
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "lut": {
          "$ref": "#/$defs/lut"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "$comment": "Original VTK uint8-01 validity controls nodal interpolation; sentinel equality never determines occupancy. Keep literal raw LUT domain, including equal endpoints. Common normalization t=clamp((scalar-lo)/max(hi-lo,1e-6),0,1); alpha=opacity*(0.02+0.6*abs(2*t-1)^1.5)."
    },
    "packetV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "source",
        "coordinateSystem",
        "timeSeconds",
        "layers",
        "runConvergence",
        "volume"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.render-result-layers/v3"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "coordinateSystem": {
          "$ref": "#/$defs/coordinateSystem"
        },
        "timeSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "layers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/meshEdgesV2"
              },
              {
                "$ref": "#/$defs/surfaceFieldV2"
              },
              {
                "$ref": "#/$defs/slice"
              },
              {
                "$ref": "#/$defs/streamline"
              }
            ]
          }
        },
        "runConvergence": {
          "$ref": "#/$defs/runConvergence"
        },
        "volume": {
          "$ref": "#/$defs/commonVolume"
        }
      }
    },
    "packetV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "source",
        "coordinateSystem",
        "timeSeconds",
        "layers",
        "meshPreview"
      ],
      "properties": {
        "schema": {
          "const": "dcdtuni.render-result-layers/v4"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/meshOnlySource"
        },
        "coordinateSystem": {
          "$ref": "#/$defs/coordinateSystem"
        },
        "timeSeconds": {
          "type": "null"
        },
        "layers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/meshEdgesV4"
              },
              {
                "$ref": "#/$defs/meshFacesV4"
              }
            ]
          }
        },
        "meshPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meshSnapshotKey",
            "meshPayloadSha256",
            "meshMetadataSha256"
          ],
          "properties": {
            "meshSnapshotKey": {
              "$ref": "#/$defs/sha256"
            },
            "meshPayloadSha256": {
              "$ref": "#/$defs/sha256"
            },
            "meshMetadataSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "meshOnlySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectUid",
        "projectContentSha256",
        "cfdrunSha256",
        "meshReceiptSha256",
        "meshQuality",
        "run"
      ],
      "properties": {
        "projectUid": {
          "type": "string",
          "minLength": 1
        },
        "projectContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cfdrunSha256": {
          "$ref": "#/$defs/sha256"
        },
        "meshReceiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "meshQuality": {
          "const": "accepted"
        },
        "run": {
          "type": "null"
        }
      }
    },
    "meshEdgesV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layerId",
        "visible",
        "meshPatchName",
        "boundaryProvenance",
        "positions",
        "indices",
        "opacity",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "meshEdges"
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        },
        "meshPatchName": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "indices": {
          "$ref": "#/$defs/indices"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boundaryProvenance": {
          "$ref": "#/$defs/nativeBoundaryProvenance"
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
