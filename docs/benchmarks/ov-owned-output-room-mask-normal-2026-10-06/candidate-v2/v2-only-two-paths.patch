+def _visibility_snapshot(stage, path):
+    """Own the exact RootLayer property, independently of composed opinions."""
+    from pxr import Sdf
+    root = stage.GetRootLayer()
+    property_path = Sdf.Path(path).AppendProperty("visibility")
+    backup = Sdf.Layer.CreateAnonymous("volume-visibility")
+    authored = root.GetAttributeAtPath(property_path) is not None
+    if authored:
+        Sdf.CreatePrimInLayer(backup, property_path.GetPrimPath())
+        if not Sdf.CopySpec(root, property_path, backup, property_path):
+            raise RuntimeError("cannot save root visibility: " + path)
+    # Root authoring can create over ancestors for a prim defined only in a
+    # sublayer. Off removes only those originally absent, still-empty overs.
+    missing = []
+    parent = property_path.GetPrimPath()
+    while parent != Sdf.Path.absoluteRootPath:
+        if root.GetPrimAtPath(parent) is None:
+            missing.append(parent)
+        parent = parent.GetParentPath()
+    return root, backup, property_path, authored, tuple(missing)
+
+
+def _restore_visibility(stage, snapshot):
+    from pxr import Sdf
+    root, backup, property_path, authored, missing = snapshot
+    if stage.GetRootLayer() != root:
+        raise RuntimeError("volume mask belongs to a different RootLayer")
+    # A removed model is retired, never resurrected by display cleanup.
+    if stage.GetPrimAtPath(property_path.GetPrimPath()).IsValid():
+        current = root.GetAttributeAtPath(property_path)
+        if current is not None:
+            current.owner.RemoveProperty(current)
+        if authored:
+            Sdf.CreatePrimInLayer(root, property_path.GetPrimPath())
+            if not Sdf.CopySpec(backup, property_path, root, property_path):
+                raise RuntimeError("cannot restore root visibility: " + str(property_path))
+    for path in missing:  # deepest first; do not remove later unrelated edits
+        spec = root.GetPrimAtPath(path)
+        if (spec is not None and spec.specifier == Sdf.SpecifierOver
+                and not spec.properties and not spec.nameChildren
+                and set(spec.ListInfoKeys()) <= {"specifier"}):
+            stage.RemovePrim(path)
