              "maxItems": 16
            },
            "cameraTransform": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 16,
              "maxItems": 16
            },
            "matrixConvention": {
              "const": "Gf-row-vector; row-major-16"
            },
            "ndcToTextureSamples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ndc": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -1e+18,
                      "maximum": 1e+18
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "uv": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": -1e+18,
                          "maximum": 1e+18
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "insideTexture": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ndc",
                  "uv",
                  "insideTexture"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "uv": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "uv"
                      ]
                    },
                    "then": {
                      "properties": {
                        "insideTexture": {
                          "const": false
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 3,
              "maxItems": 5
            },
            "appSizePx": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768
              },
              "minItems": 2,
              "maxItems": 2
            },
            "appPositionScreenPx": {
              "type": "array",
              "items": {
