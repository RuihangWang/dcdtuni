                  "cameraPath",
                  "resolution",
                  "fullResolution",
                  "view",
                  "uiProjection",
                  "worldToNdc",
                  "ndcToTextureSamples",
                  "matrixConvention"
                ],
                "properties": {
                  "stageSame": {
                    "const": true
                  },
                  "expectedCameraSame": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
