        "backgroundGrid": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "spacingM": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "divisions": {
              "type": "integer",
              "minimum": 4,
              "maximum": 4000
            },
            "extentM": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2002
            },
            "centerColor": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "lineColor": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "matrix": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 16,
              "maxItems": 16
            }
          },
          "required": [
            "visible",
            "spacingM",
            "divisions",
            "extentM",
            "centerColor",
            "lineColor",
            "opacity",
            "matrix"
          ],
          "additionalProperties": false
        },
        "backgroundGridRaster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metricVersion",
            "line",
            "output",
            "binding"
          ],
          "properties": {
            "line": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "drawingBuffer",
                "css",
                "pixelRatio",
                "aliasedRange",
                "effectiveWidthPx",
                "coordinateFrame",
                "worldToClip"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "drawingBuffer": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "css": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "pixelRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "aliasedRange": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "effectiveWidthPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "coordinateFrame": {
                  "type": "string",
                  "enum": [
                    "scene-world"
                  ]
                },
                "worldToClip": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "revision",
                "decoded",
                "css",
                "layoutCss",
                "objectFit"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "decoded": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1600
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 900
                    }
                  ],
                  "additionalItems": false
                },
                "css": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "layoutCss": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "objectFit": {
                  "type": "string",
                  "enum": [
                    "contain"
                  ]
                }
              }
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projectUid",
                "projectContentSha256",
                "sceneRevision",
                "viewRevision"
              ],
              "properties": {
                "projectUid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "projectContentSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sceneRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "viewRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "metricVersion": {
              "type": "integer",
              "enum": [
                2
              ]
            }
          }
        }
      },
      "required": [
        "selectedUids",
        "timeSeconds"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "dcdtuni.render-display-diagnostics/v1"
        },
        "profile": {
          "const": "bounded-display-v1"
        },
        "sampleSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
