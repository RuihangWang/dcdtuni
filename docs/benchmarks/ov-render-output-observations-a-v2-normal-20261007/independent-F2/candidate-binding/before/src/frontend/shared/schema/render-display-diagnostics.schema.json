        "sampleElapsedMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        },
        "pixelVerified": {
          "const": false
        },
        "renderer": {
          "type": "object",
          "properties": {
            "viewportHydraEngine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:+-]+$"
            },
            "viewportRenderMode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:+-]+$"
            },
            "globalRtxMode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:+-]+$"
