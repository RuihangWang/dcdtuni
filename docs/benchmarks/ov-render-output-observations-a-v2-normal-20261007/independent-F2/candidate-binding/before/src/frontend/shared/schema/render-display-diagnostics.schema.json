                    "value": {
                      "type": "boolean"
                    },
                    "reason": {
                      "enum": [
                        "none",
                        "disabled",
                        "no-viewport",
                        "stage-mismatch",
                        "camera-mismatch",
                        "source-context-changed",
                        "invalid-public-value",
                        "layout-unresolved",
                        "target-missing",
                        "target-not-acknowledged",
                        "target-fanout",
                        "not-owned-binding",
                        "unsupported-shader",
                        "unsupported-connection",
                        "missing-setting",
                        "unexpected-setting-type",
                        "reply-limit",
                        "rate-limit",
                        "base-view-limit"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "observed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "value"
                        ],
                        "properties": {
                          "reason": {
                            "const": "none"
                          }
                        }
                      }
                    }
                  ]
                },
                "raytracingFractionalCutoutOpacity": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "pending",
                        "unavailable"
                      ]
                    },
                    "value": {
                      "type": "boolean"
                    },
                    "reason": {
                      "enum": [
                        "none",
                        "disabled",
                        "no-viewport",
                        "stage-mismatch",
                        "camera-mismatch",
                        "source-context-changed",
                        "invalid-public-value",
                        "layout-unresolved",
                        "target-missing",
                        "target-not-acknowledged",
                        "target-fanout",
                        "not-owned-binding",
                        "unsupported-shader",
                        "unsupported-connection",
                        "missing-setting",
                        "unexpected-setting-type",
                        "reply-limit",
                        "rate-limit",
                        "base-view-limit"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "observed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "value"
                        ],
                        "properties": {
                          "reason": {
                            "const": "none"
                          }
                        }
                      }
                    }
                  ]
                },
                "pathtracingFractionalCutoutOpacity": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "pending",
                        "unavailable"
                      ]
                    },
                    "value": {
                      "type": "boolean"
                    },
                    "reason": {
                      "enum": [
                        "none",
                        "disabled",
                        "no-viewport",
                        "stage-mismatch",
                        "camera-mismatch",
                        "source-context-changed",
                        "invalid-public-value",
                        "layout-unresolved",
                        "target-missing",
                        "target-not-acknowledged",
                        "target-fanout",
                        "not-owned-binding",
                        "unsupported-shader",
                        "unsupported-connection",
                        "missing-setting",
                        "unexpected-setting-type",
                        "reply-limit",
                        "rate-limit",
                        "base-view-limit"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "observed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "value"
