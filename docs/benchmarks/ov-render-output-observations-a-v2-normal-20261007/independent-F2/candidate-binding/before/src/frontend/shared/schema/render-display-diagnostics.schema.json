        "viewport": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "observed",
                "pending",
                "unavailable"
              ]
            },
            "reason": {
              "enum": [
                "none",
                "disabled",
                "no-viewport",
                "stage-mismatch",
                "camera-mismatch",
                "source-context-changed",
                "invalid-public-value",
                "layout-unresolved",
                "target-missing",
                "target-not-acknowledged",
                "target-fanout",
                "not-owned-binding",
