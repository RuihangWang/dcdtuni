{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded readonly OV display diagnostic ACK (payload UTF-8 <=16384 bytes)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "ok",
    "sceneRevision",
    "projectHash",
    "diagnostics",
    "view"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "ok": {
      "const": true
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "view": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "up": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "fov": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180,
              "maximum": 1e+18
            },
            "aspect": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1e+18
            },
            "near": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1e+18
            },
            "far": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1e+18
            }
          },
          "required": [
            "position",
            "target",
            "up",
            "fov",
            "aspect",
            "near",
            "far"
          ],
          "additionalProperties": false
        },
        "selectedUids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 8
        },
        "timeSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
