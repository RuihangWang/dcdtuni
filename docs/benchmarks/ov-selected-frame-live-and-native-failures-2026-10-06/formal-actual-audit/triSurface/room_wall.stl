solid Room_Wall_2
  facet normal 1.000000 0.000000 -0.000000
    outer loop
      vertex 1.000000 1.000000 1.000000
      vertex 1.000000 0.000000 1.000000
      vertex 1.000000 0.000000 0.000000
    endloop
  endfacet
  facet normal 1.000000 0.000000 -0.000000
    outer loop
      vertex 1.000000 0.000000 0.000000
      vertex 1.000000 1.000000 0.000000
      vertex 1.000000 1.000000 1.000000
    endloop
  endfacet
endsolid Room_Wall_2

solid Room_Wall_4
  facet normal -1.000000 0.000000 -0.000000
    outer loop
      vertex 0.000000 1.000000 0.000000
      vertex 0.000000 0.000000 0.000000
      vertex 0.000000 0.000000 1.000000
    endloop
  endfacet
  facet normal -1.000000 0.000000 -0.000000
    outer loop
      vertex 0.000000 0.000000 1.000000
      vertex 0.000000 1.000000 1.000000
      vertex 0.000000 1.000000 0.000000
    endloop
  endfacet
endsolid Room_Wall_4

