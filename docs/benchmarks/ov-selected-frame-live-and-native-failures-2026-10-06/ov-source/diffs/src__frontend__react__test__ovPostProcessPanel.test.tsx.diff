+  setLiveAirResultSelection(selection)
+  publishResultLayerSet({schema:'dcdtuni.render-result-layers/v1',revision:resultLayerRevision()+1,
+    source,coordinateSystem:{upAxis:'Y',metersPerUnit:1,handedness:'right'},timeSeconds:time,
+    layers:[{kind:'meshEdges',layerId:'wall',visible:true,meshPatchName:'wall',sourceFaceUids:['wall/f'],
+      positions:[0,0,0,1,0,0],indices:[0,1],opacity:1}]},source,time,undefined,'air-postprocess',selection)
+}
