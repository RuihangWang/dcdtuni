+function publishThreeFrame(time: number, revision: string) {
+  const source={ projectUid:'p',projectContentSha256:'a'.repeat(64),cfdrunSha256:'b'.repeat(64),
+    meshReceiptSha256:'c'.repeat(64),meshQuality:'accepted' as const,run:{uid:'execution',receiptSha256:'d'.repeat(64)} }
