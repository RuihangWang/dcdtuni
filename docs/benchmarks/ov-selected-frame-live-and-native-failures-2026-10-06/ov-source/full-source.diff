+    grid = types.SimpleNamespace(GetBounds=lambda: (0, 1, 0, 1, 0, 1))
+    read_grid = lambda path: grid
+    module("race_bridge.slice_render", read_grid=read_grid)
+
+    async def executor(_pool, func, *args):
