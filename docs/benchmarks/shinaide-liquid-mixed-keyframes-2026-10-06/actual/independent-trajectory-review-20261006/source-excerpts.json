    "lines": {
      "76": "def assemble(definition, state):",
      "77": "    \"\"\"Independent node elimination and water/solid/two-fluid heat balances.",
      "78": "",
      "79": "    Read topology/property VALUES, not production residual coefficients. This",
      "80": "    implementation handles every pipe, every cold plate and every exchanger.",
      "81": "    \"\"\"",
      "108": "    cp = float(p['fluid_cp'][0])",
      "109": "    rho = float(p['fluid_rho'][0])",
      "110": "    epsilon = np.array([1 - np.exp(-p['cp_UA'][i] / (weight[e] * cp)) if weight[e] > 0 else 0.",
      "135": "    cw = rho * cp * p['cell_volume']",
      "136": "    cs = p['cp_Csolid']",
      "137": "    ch = rho * cp * p['secondary_volume']",
      "138": "    cpri = p['primary_rho'] * p['primary_cp'] * p['primary_volume']",
      "139": "    C = np.concatenate([cw, cs, ch, cpri])",
      "140": "    A, b = np.zeros((nx, nx)), np.zeros(nx)",
      "141": "    for cell, edge in enumerate(owner):",
      "142": "        wc = weight[edge] * cp",
      "143": "        A[cell, cell] -= wc / cw[cell]",
      "144": "        if (actual[edge] >= 0 and cell == first[edge]) or (actual[edge] < 0 and cell == last[edge]):",
      "145": "            A[cell] += wc / cw[cell] * S[up[edge]]",
      "146": "            b[cell] += wc / cw[cell] * g[up[edge]]",
      "147": "        else:",
      "148": "            A[cell, cell - 1 if actual[edge] >= 0 else cell + 1] += wc / cw[cell]",
      "149": "        b[cell] += p['cell_heat_W'][cell] / cw[cell]",
      "150": "    for local, edge in enumerate(ids['cp']):",
      "151": "        index = ss.start + local",
      "152": "        G = weight[edge] * cp * epsilon[local]",
      "153": "        A[index, index] -= G / cs[local]",
      "154": "        A[index] += G / cs[local] * S[up[edge]]",
      "155": "        b[index] += G / cs[local] * g[up[edge]] + p['heat_W'][local] / cs[local]",
      "156": "    for local, edge in enumerate(ids['hx']):",
      "157": "        isec, ipri = sh.start + local, sp.start + local",
      "158": "        wc, ua = weight[edge] * cp, p['hx_UA'][local]",
      "159": "        mc = p['primary_flow_kg_s'][local] * p['primary_cp'][local]",
      "160": "        A[isec, isec] -= (wc + ua) / ch[local]",
      "161": "        A[isec, ipri] += ua / ch[local]",
      "162": "        A[isec] += wc / ch[local] * S[up[edge]]",
      "163": "        b[isec] += wc / ch[local] * g[up[edge]]",
      "164": "        A[ipri, isec] += ua / cpri[local]",
      "165": "        A[ipri, ipri] -= (ua + mc) / cpri[local]",
      "166": "        b[ipri] += mc / cpri[local] * p['primary_inlet_K'][local]",
      "167": "    return dict(A=A, b=b, S=S, g=g, C=C, p=p, ids=ids, owner=owner, first=first, last=last,",
      "168": "                cw=cw, cs=cs, ch=ch, cpri=cpri, up=up, down=down, weight=weight,",
      "169": "                actual=actual, dynamic=dynamic, sw=sw, ss=ss, sh=sh, sp=sp, layout=layout,"
    }
  }
