+    w.put(",\"secondHalo\":");w.labels(v.secondHalo);w.put(",\"origins\":[");bool first=true;
+    for(const auto& o:v.origins){if(!first)w.put(",");first=false;origin(w,o);}w.put("],\"cells\":[");first=true;
+    for(const auto& c:v.cells)
