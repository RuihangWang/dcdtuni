FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantBoussinesqPimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         5.0;

deltaT          0.1;

writeControl    adjustableRunTime;

writeInterval   1.0;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

// Read by buoyantBoussinesqSimpleFoam_new (third_parties/foam). Stock OpenFOAM
// writes `type zeroGradient;` for T and `type noSlip;` for U with no numbers at
// all, so any tool reading the raw result files finds a hole exactly where the
// wall data should be. This makes every physical patch carry its per-face values.
//   preserveType  keep the real BC type and append the values — complete data
//                 AND the case still restarts correctly.
//   fixedValue    replace the type with fixedValue. Fully explicit, but a
//                 restart then re-runs a DIFFERENT problem, because e.g. a
//                 flowRateInletVelocity inlet becomes a frozen velocity.
// Ignored by solvers that do not implement it.
explicitBoundaryValues
{
    mode        preserveType;
}

timeFormat      general;

timePrecision   10;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           1.0;

maxDeltaT       1.0;

functions
{
	probes
	{
		// Where to load it from
		libs ( "libsampling.so" );
		type probes;
		enabled true;
		// Name of the directory for probe data
		name probes;
		// Write control
		writeControl adjustableRunTime;
		writeInterval 0.1;
		// Fields to be probed
		fields
		(
			T
			rho
            p
            p_rgh
            U
		);
        probeLocations
        (
                (3.25 1.13 3.46)
                (4.37 0.96 0.65)
                (4.15 0.65 5.48)
        );
   }
}

// ************************************************************************* //