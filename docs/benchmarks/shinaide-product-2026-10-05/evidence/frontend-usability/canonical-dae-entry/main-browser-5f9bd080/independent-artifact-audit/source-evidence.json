            "138": "def resolve_parameter_pack(data: Any) -> Any:",
            "139": "    \"\"\"Materialize profile references without mutating caller-owned data.",
            "140": "",
            "141": "    No file access, network access or dynamic code execution occurs here.",
            "142": "    Unreferenced legacy manifests remain unchanged. Resolved snapshots retain",
            "143": "    their provenance and contain no active references, so reload is idempotent.",
            "144": "    \"\"\"",
            "145": "    if not isinstance(data, dict):",
            "146": "        return data",
            "147": "    refs = any(isinstance(edge, dict) and edge.get(\"parameter_ref\") is not None",
            "148": "               for edge in data.get(\"edges\", [])) or data.get(\"fluid_ref\") is not None",
            "149": "    if data.get(\"parameter_pack\") is None:",
            "150": "        if refs:",
            "151": "            raise ValueError(\"parameter_pack is required when a profile is referenced\")",
            "152": "        return data",
            "153": "",
            "154": "    pack = ParameterPack.model_validate(data[\"parameter_pack\"])",
            "155": "    result = deepcopy(data)",
            "156": "    result.pop(\"parameter_pack\")",
            "157": "    bindings: dict[str, Any] = {\"edges\": {}}",
            "158": "",
            "159": "    def bind(ref: str, expected_type: str, overrides: dict, identity: str) -> dict:",
            "160": "        if not isinstance(ref, str) or not ref:",
            "161": "            raise ValueError(f\"parameter reference for {identity} must be a non-empty string\")",
            "162": "        if ref not in pack.profiles:",
            "163": "            raise ValueError(f\"unknown parameter profile {ref!r} for {identity}\")",
            "164": "        profile = pack.profiles[ref]",
            "165": "        if profile.type != expected_type:",
            "166": "            raise ValueError(f\"profile type {profile.type!r} does not match {expected_type!r} for {identity}\")",
            "167": "        target_bindings = bindings if expected_type == \"fluid\" else bindings[\"edges\"]",
            "168": "        if identity in target_bindings:",
            "169": "            raise ValueError(f\"duplicate parameter binding identity {identity!r}\")",
            "170": "        _validate_params(expected_type, overrides, f\"{identity}.overrides\", edge_only=True)",
            "171": "        values = deepcopy(profile.params)",
            "172": "        values.update(deepcopy(overrides))",
            "173": "        target_bindings[identity] = {\"profile\": ref, \"overrides\": deepcopy(overrides)}",
            "174": "        return values",
            "175": "",
            "176": "    if result.get(\"fluid_ref\") is not None:",
            "177": "        ref = result.pop(\"fluid_ref\")",
            "178": "        result[\"fluid\"] = bind(ref, \"fluid\", result.get(\"fluid\", {}), \"fluid\")",
            "179": "    for edge in result.get(\"edges\", []):",
            "180": "        if edge.get(\"parameter_ref\") is not None:",
            "181": "            ref = edge.pop(\"parameter_ref\")",
            "182": "            edge[\"params\"] = bind(ref, edge[\"type\"], edge.get(\"params\", {}), edge[\"id\"])",
            "183": "",
            "184": "    snapshot = pack.model_dump(mode=\"json\")",
            "185": "    effective_edges = [",
            "186": "        {\"id\": edge.get(\"id\"), \"type\": edge.get(\"type\"), \"params\": edge.get(\"params\", {})}",
            "187": "        for edge in result.get(\"edges\", [])",
            "188": "    ]",
            "189": "    effective_edges.sort(key=lambda edge: str(edge[\"id\"]))",
            "190": "    result[\"parameter_provenance\"] = {",
            "191": "        \"id\": pack.id, \"revision\": pack.revision, \"source\": pack.source,",
            "192": "        \"description\": pack.description, \"sha256\": _digest(snapshot),",
            "193": "        \"bindings\": bindings,",
            "194": "        \"resolved_sha256\": _digest({\"fluid\": result.get(\"fluid\"), \"edges\": effective_edges}),",
            "195": "    }",
            "196": "    return result"
          }
        }
      ]
