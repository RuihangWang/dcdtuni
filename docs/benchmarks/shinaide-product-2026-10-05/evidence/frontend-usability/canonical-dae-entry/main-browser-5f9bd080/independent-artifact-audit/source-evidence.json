            "443": "",
            "444": "  // cfdproj v5: a live project carries its time-variable fields materialised",
            "445": "  // at the playhead; on disk they exist only in `transient.tracks`. The hash",
            "446": "  // is of the disk form, so a live project, a reopened file and a copy",
            "447": "  // materialised at another time all bind to the same content.",
            "448": "  function canonicalProjectForHash(state) {",
            "449": "    var tr = state && state.transient;",
            "450": "    if (!tr || !Array.isArray(tr.tracks) || !tr.tracks.length) return state;",
            "451": "    var T = (typeof window !== 'undefined' && window.cfdprojTransient) ||",
            "452": "      (typeof require === 'function' ? require('./cfdproj_transient.js') : null);",
            "453": "    if (!T) throw new Error('cfdrun_export: cfdproj_transient.js is required to hash a v5 project');",
            "454": "    return T.stripTrackedFields(JSON.parse(JSON.stringify(state)));",
            "455": "  }"
