            "65": "def _validate_params(kind: str, values: dict, location: str, *, edge_only: bool = False) -> None:",
            "66": "    if not isinstance(values, dict):",
            "67": "        raise ValueError(f\"{location} must be a parameter object\")",
            "68": "    extra = _EDGE_ONLY_FIELDS.get(kind, {}) if edge_only else {}",
            "69": "    unsupported = set(values) - _PROFILE_FIELDS[kind] - set(extra)",
            "70": "    if unsupported:",
            "71": "        raise ValueError(f\"unsupported parameter for {kind}: {sorted(unsupported)}\")",
            "72": "    for name, value in values.items():",
            "73": "        where = f\"{location}.{name}\"",
            "74": "        if name in extra and extra[name] is not None:",
