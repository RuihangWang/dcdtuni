        "lines": {
          "3627": "def handle_browser_screenshot(handler) -> None:",
          "3628": "    \"\"\"GET /api/browser/screenshot?name=xxx\"\"\"",
          "3629": "    if not _ensure_browser(handler):",
          "3630": "        _send_json(handler, 500, {\"error\": \"Failed to start headless browser\"})",
          "3631": "        return",
          "3632": "    parsed = urlparse(handler.path)",
          "3633": "    query = parse_qs(parsed.query)",
          "3634": "    name = query.get(\"name\", [\"api_debug\"])[0]",
          "3635": "    try:",
          "3636": "        path = _browser_call(\"screenshot\", name)",
          "3637": "        _send_json(handler, 200, {\"path\": path})",
          "3638": "    except Exception as e:",
          "3639": "        _send_json(handler, 500, {\"error\": str(e)})"
        }
      },
      {
        "first": 4683,
        "last": 4699,
        "lines": {
          "4683": "def handle_screenshot(handler: http.server.BaseHTTPRequestHandler) -> None:",
          "4684": "    \"\"\"Save a base64-encoded screenshot from the browser to a file.\"\"\"",
          "4685": "    data = _read_body(handler)",
          "4686": "    image_data = data.get(\"imageData\", \"\")  # data:image/png;base64,...",
          "4687": "    if not image_data:",
          "4688": "        _send_json(handler, 400, {\"error\": \"missing imageData\"})",
          "4689": "        return",
          "4690": "    # Strip data URL prefix",
          "4691": "    if \",\" in image_data:",
          "4692": "        image_data = image_data.split(\",\", 1)[1]",
          "4693": "    screenshot_dir = CASE_DIR / \"screenshots\" if CASE_DIR else Path(\"screenshots\")",
          "4694": "    screenshot_dir.mkdir(parents=True, exist_ok=True)",
          "4695": "    import datetime",
          "4696": "    timestamp = datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")",
          "4697": "    filepath = screenshot_dir / f\"ui_screenshot_{timestamp}.png\"",
          "4698": "    filepath.write_bytes(base64.b64decode(image_data))",
          "4699": "    _send_json(handler, 200, {\"path\": str(filepath), \"timestamp\": timestamp})"
        }
      }
    ]
  },
