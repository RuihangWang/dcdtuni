          "629": "                        not re.fullmatch(r'[0-9a-f]{64}', project_hash)):",
          "630": "                    raise ValueError('Invalid project content hash')",
          "631": "                print(f'[dc.cfd_bridge] scene load begin primitives={len(packet[\"primitives\"])}')",
          "632": "                cache = os.environ.get('DCDTUNI_RENDER_TEXTURE_CACHE', '/tmp/dcdtuni-render-textures')",
          "633": "                result = render_scene.author_scene(stage, packet, cache, validated=True)",
          "634": "                print(f'[dc.cfd_bridge] scene load authored primitives={result[\"primitives\"]}')",
          "635": "                self._render_uid_paths = result['uidPaths']",
          "636": "                self._render_primitive_ids = {p['id']: p['modelUid'] for p in packet['primitives']}",
          "637": "                self._render_project_hash = project_hash",
          "638": "                self._last_scene_request_id = request_id",
