        "lines": {
          "6": "/**",
          "7": " * Save the viewport as a PNG under the case directory.",
          "8": " *",
          "9": " * The canvas is re-rendered first. A WebGL canvas without `preserveDrawingBuffer`",
          "10": " * is CLEARED after each present, so `toDataURL` on a canvas that has not just",
          "11": " * drawn returns a blank image \u2014 and a blank screenshot looks like a broken",
          "12": " * viewport rather than a mistimed read.",
          "13": " */",
          "14": "async function captureScreenshot() {",
          "15": "  const handle = (window as unknown as { __viewportRender?: () => HTMLCanvasElement | null })",
          "16": "    .__viewportRender",
          "17": "  const canvas = handle?.() ?? document.querySelector<HTMLCanvasElement>('#center-view canvas')",
          "18": "  if (!canvas) {",
          "19": "    store.logOperation('captureScreenshot', 'no canvas')",
          "20": "    return",
          "21": "  }",
          "22": "  try {",
          "23": "    const imageData = canvas.toDataURL('image/png')",
          "24": "    const resp = await fetch('/api/screenshot', {",
          "25": "      method: 'POST',",
          "26": "      headers: { 'Content-Type': 'application/json' },",
          "27": "      body: JSON.stringify({ imageData }),",
          "28": "    })",
          "29": "    const result = (await resp.json()) as { path?: string; error?: string }",
          "30": "    store.logOperation('captureScreenshot', result.error ?? result.path ?? 'saved')",
          "31": "  } catch (e) {",
          "32": "    store.logOperation('captureScreenshot', e instanceof Error ? e.message : String(e))",
          "33": "  }",
          "34": "}"
        }
      },
      {
        "first": 207,
        "last": 218,
        "lines": {
          "207": "            className={view === 'log' ? 'active' : undefined}",
