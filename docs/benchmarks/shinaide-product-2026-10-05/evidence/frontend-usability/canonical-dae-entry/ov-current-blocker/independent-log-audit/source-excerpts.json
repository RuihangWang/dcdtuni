          "437": "    def _render_ack(self, request_id, **result):",
          "438": "        self._ack_queue.append({'requestId': request_id, **result})",
          "439": "        if not self._ack_flushing:",
          "440": "            self._ack_flushing = True",
          "441": "            asyncio.ensure_future(self._flush_acks())",
          "442": "",
          "443": "    async def _flush_acks(self):",
          "444": "        \"\"\"Push queued acks once the inbound side has been quiet for",
          "445": "        ACK_QUIET_FRAMES frames (capped, so a steady inbound stream such as a",
          "446": "        camera drag cannot starve them). See ACK_QUIET_FRAMES.\"\"\"",
          "447": "        app = omni.kit.app.get_app()",
          "448": "        event = carb.events.type_from_string('dcdtuni:renderAck')",
          "449": "        try:",
          "450": "            while self._ack_queue:",
          "451": "                quiet = waited = 0",
          "452": "                while quiet < self.ACK_QUIET_FRAMES and waited < self.ACK_MAX_WAIT_FRAMES:",
          "453": "                    seen = self._inbound_seq",
          "454": "                    await app.next_update_async()",
          "455": "                    waited += 1",
          "456": "                    quiet = quiet + 1 if self._inbound_seq == seen else 0",
          "457": "                batch, self._ack_queue = self._ack_queue, []",
          "458": "                for payload in batch:",
          "459": "                    app.get_message_bus_event_stream().push(event, payload=payload)",
          "460": "        finally:",
          "461": "            self._ack_flushing = False"
        }
      },
      {
        "first": 625,
        "last": 650,
        "lines": {
          "625": "            if command == 'loadRenderScene':",
