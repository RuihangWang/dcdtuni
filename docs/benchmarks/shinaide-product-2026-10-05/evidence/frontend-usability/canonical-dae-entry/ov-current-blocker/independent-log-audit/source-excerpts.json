          "378": "def author_scene(stage, packet, texture_dir, asset_prefix=None, validated=False):",
          "379": "    \"\"\"Build a validated layer; optional relative asset prefix makes disk exports portable.",
          "380": "",
          "381": "    Kit's in-memory stages retain absolute cache references by default. The CLI",
          "382": "    writes textures beside the exported stage and supplies its relative prefix.",
          "383": "    validated=True only for a packet SceneTransfer.finish() has just validated:",
          "384": "    the pure-Python walk over every vertex is a large share of the Kit-side",
          "385": "    load, and running it twice doubled that.",
          "386": "    \"\"\"",
          "387": "    from pxr import Gf, Sdf, Usd, UsdGeom, UsdShade, UsdLux",
          "388": "    if not validated:",
          "389": "        validate_snapshot(packet)",
          "390": "    texture_dir = Path(texture_dir)",
          "391": "    if asset_prefix is not None and Path(asset_prefix).is_absolute():",
          "392": "        raise ValueError('Export asset prefix must be relative to the USD file')",
          "393": "    assets = {}",
          "394": "    for key, uri in packet['textures'].items():",
          "395": "        data, suffix = texture_bytes(uri)",
          "396": "        texture_dir.mkdir(parents=True, exist_ok=True)",
          "397": "        file = texture_dir / (hashlib.sha256(data).hexdigest() + suffix)",
          "398": "        if not file.exists():",
          "399": "            file.write_bytes(data)",
          "400": "        assets[key] = ((Path(asset_prefix) / file.name).as_posix()",
          "401": "                       if asset_prefix is not None else str(file.resolve()))",
          "402": "    work = Usd.Stage.CreateInMemory()"
        }
      }
    ]
  }
