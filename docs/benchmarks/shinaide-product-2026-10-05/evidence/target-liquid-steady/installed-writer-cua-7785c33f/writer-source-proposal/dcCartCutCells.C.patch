+std::size_t writerCutPayloadBytes(const WriterCutMesh& m)
+{
+    std::size_t n=sizeof(m)+m.points.capacity()*sizeof(point)
+        +m.faces.capacity()*sizeof(std::vector<label>);
+    for (const auto& f:m.faces) { n+=f.capacity()*sizeof(label); }
