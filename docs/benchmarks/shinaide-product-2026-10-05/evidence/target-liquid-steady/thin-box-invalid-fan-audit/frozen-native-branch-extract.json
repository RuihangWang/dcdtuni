        {
          "line": 279,
          "text": "//- Newell normal (magnitude = area) and centroid of a polygon"
        },
        {
          "line": 280,
          "text": "void polygonNormalCentre"
        },
        {
          "line": 281,
          "text": "("
        },
        {
          "line": 282,
          "text": "    const std::vector<point>& pts,"
        },
        {
          "line": 283,
          "text": "    const std::vector<label>& poly,"
        },
        {
          "line": 284,
          "text": "    vector& n,"
        },
        {
          "line": 285,
          "text": "    point& c"
        },
        {
          "line": 286,
          "text": ")"
        },
        {
          "line": 287,
          "text": "{"
        },
        {
          "line": 288,
          "text": "    n = vector::zero;"
        },
        {
          "line": 289,
          "text": "    c = point::zero;"
        },
        {
          "line": 290,
          "text": "    const label k = label(poly.size());"
        },
        {
          "line": 291,
          "text": "    if (k < 3) { return; }"
        },
        {
          "line": 292,
          "text": "    for (label i = 0; i < k; ++i)"
        },
        {
          "line": 293,
          "text": "    {"
        },
        {
          "line": 294,
          "text": "        const point& a = pts[poly[i]];"
        },
        {
          "line": 295,
          "text": "        const point& b = pts[poly[(i + 1) % k]];"
        },
        {
          "line": 296,
          "text": "        n.x() += (a.y() - b.y()) * (a.z() + b.z());"
        },
        {
          "line": 297,
          "text": "        n.y() += (a.z() - b.z()) * (a.x() + b.x());"
        },
        {
          "line": 298,
          "text": "        n.z() += (a.x() - b.x()) * (a.y() + b.y());"
        },
        {
          "line": 299,
          "text": "        c += a;"
        },
        {
          "line": 300,
          "text": "    }"
        },
        {
          "line": 301,
          "text": "    n *= 0.5;"
        },
        {
          "line": 302,
          "text": "    c /= scalar(k);"
        },
        {
          "line": 303,
          "text": "}"
        }
