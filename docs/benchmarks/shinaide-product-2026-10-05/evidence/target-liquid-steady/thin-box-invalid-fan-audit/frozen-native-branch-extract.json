    {
      "label": "Native OF area and centroid arithmetic",
      "firstLine": 7127,
      "lastLine": 7177,
      "lines": [
        {
          "line": 7127,
          "text": "inline void faceAreaCentreOF"
        },
        {
          "line": 7128,
          "text": "("
        },
        {
          "line": 7129,
          "text": "    const std::vector<Foam::point>& pts,"
        },
        {
          "line": 7130,
          "text": "    const std::vector<Foam::label>& poly,"
        },
        {
          "line": 7131,
          "text": "    Foam::vector& A,"
        },
        {
          "line": 7132,
          "text": "    Foam::point& C"
        },
        {
          "line": 7133,
          "text": ")"
        },
        {
          "line": 7134,
          "text": "{"
        },
        {
          "line": 7135,
          "text": "    using namespace Foam;"
        },
        {
          "line": 7136,
          "text": "    A = vector::zero;"
        },
        {
          "line": 7137,
          "text": "    C = point::zero;"
        },
        {
          "line": 7138,
          "text": "    const label k = label(poly.size());"
        },
        {
          "line": 7139,
          "text": "    if (k < 3)"
        },
        {
          "line": 7140,
          "text": "    {"
        },
        {
          "line": 7141,
          "text": "        for (label v : poly) { C += pts[v]; }"
        },
        {
          "line": 7142,
          "text": "        if (k) { C /= scalar(k); }"
        },
        {
          "line": 7143,
          "text": "        return;"
        },
        {
          "line": 7144,
          "text": "    }"
        },
        {
          "line": 7145,
          "text": "    if (k == 3)"
        },
        {
          "line": 7146,
          "text": "    {"
        },
        {
          "line": 7147,
          "text": "        C = (pts[poly[0]] + pts[poly[1]] + pts[poly[2]]) / 3.0;"
        },
        {
          "line": 7148,
          "text": "        A = 0.5 * ((pts[poly[1]] - pts[poly[0]]) ^ (pts[poly[2]] - pts[poly[0]]));"
        },
        {
          "line": 7149,
          "text": "        return;"
        },
        {
          "line": 7150,
          "text": "    }"
        },
        {
          "line": 7151,
          "text": "    point fc = point::zero;"
        },
        {
          "line": 7152,
          "text": "    for (label i = 0; i < k; ++i) { fc += pts[poly[i]]; }"
        },
        {
          "line": 7153,
          "text": "    fc /= scalar(k);"
        },
        {
          "line": 7154,
          "text": "    vector sumN = vector::zero;"
        },
        {
          "line": 7155,
          "text": "    vector sumAc = vector::zero;"
        },
        {
          "line": 7156,
          "text": "    scalar sumA = 0;"
        },
        {
          "line": 7157,
          "text": "    for (label i = 0; i < k; ++i)"
        },
        {
          "line": 7158,
          "text": "    {"
        },
        {
          "line": 7159,
          "text": "        const point& p = pts[poly[i]];"
        },
        {
          "line": 7160,
          "text": "        const point& q = pts[poly[(i + 1) % k]];"
        },
        {
          "line": 7161,
          "text": "        const vector n = (q - p) ^ (fc - p);"
        },
        {
          "line": 7162,
          "text": "        const scalar a = mag(n);"
        },
        {
          "line": 7163,
          "text": "        sumN += n;"
        },
        {
          "line": 7164,
          "text": "        sumA += a;"
        },
        {
          "line": 7165,
          "text": "        sumAc += a * (p + q + fc);"
        },
        {
          "line": 7166,
          "text": "    }"
        },
        {
          "line": 7167,
          "text": "    if (sumA < ROOTVSMALL)"
        },
        {
          "line": 7168,
          "text": "    {"
        },
        {
          "line": 7169,
          "text": "        C = fc;"
        },
        {
          "line": 7170,
          "text": "        return;"
        },
        {
          "line": 7171,
          "text": "    }"
        },
        {
          "line": 7172,
          "text": "    // Match primitiveMeshTools operation order, including rounding at the"
        },
        {
          "line": 7173,
          "text": "    // strict skewness limit. Algebraically equivalent expressions can fall"
        },
        {
          "line": 7174,
          "text": "    // on opposite sides of checkMesh's boundary threshold."
        },
        {
          "line": 7175,
          "text": "    C = (1.0 / 3.0) * sumAc / sumA;"
        },
        {
          "line": 7176,
          "text": "    A = 0.5 * sumN;"
        },
        {
          "line": 7177,
          "text": "}"
        }
      ]
