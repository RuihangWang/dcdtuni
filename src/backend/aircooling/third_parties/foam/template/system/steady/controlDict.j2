FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantBoussinesqSimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         {{ end_time }};

deltaT          {{ delta_t }};

writeControl    timeStep;

writeInterval   {{ write_interval }};

purgeWrite      0;

writeFormat     ascii;

writePrecision  {{ write_precision }};

writeCompression off;

// Read by buoyantBoussinesqSimpleFoam_new (third_parties/foam). Stock OpenFOAM
// writes `type zeroGradient;` for T and `type noSlip;` for U with no numbers at
// all, so any tool reading the raw result files finds a hole exactly where the
// wall data should be. This makes every physical patch carry its per-face values.
//   preserveType  keep the real BC type and append the values — complete data
//                 AND the case still restarts correctly.
//   fixedValue    replace the type with fixedValue. Fully explicit, but a
//                 restart then re-runs a DIFFERENT problem, because e.g. a
//                 flowRateInletVelocity inlet becomes a frozen velocity.
// Ignored by solvers that do not implement it.
explicitBoundaryValues
{
    mode        preserveType;
}

timeFormat      general;

timePrecision   {{ time_precision }};

runTimeModifiable true;

{% set surface_field_values = surface_field_values|default([]) %}
{% if probes|length > 0 or surface_field_values|length > 0 %}
functions
{
{% if probes|length > 0 %}
	probes
	{
		// Where to load it from
		libs ( "libsampling.so" );
		type probes;
		enabled true;
		// Name of the directory for probe data
		name probes;
		// Write control
		writeControl timeStep;
		writeInterval 10;
		// Fields to be probed
		fields
		(
			T
			rho
            p
            p_rgh
            U
		);
        probeLocations
        (
            {% for probe in probes %}
                ({{ probe.x }} {{ probe.y }} {{ probe.z }})
            {% endfor %}
        );
   }
{% endif %}
{% for fo in surface_field_values %}
    {{ fo.name }}
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   1;
        log             {{ fo.log|default('true') }};
        writeFields     false;
        regionType      patch;
        name            {{ fo.patch }};
        operation       {{ fo.operation|default('areaAverage') }};
{% if fo.weightField %}        weightField     {{ fo.weightField }};
{% endif %}        fields          ({{ fo.fields|default('T') }});
    }
{% endfor %}
}
{% endif %}

// ************************************************************************* //

// Note: petscFoam is only needed when using PETSc solvers (fvSolution_gpu)
// libs       (petscFoam);