solid Ground_floor
  facet normal 0 -1 0
    outer loop
      vertex 0.0 0.0 2.0
      vertex 2.0 0.0 0.0
      vertex 0.0 0.0 0.0
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0.0 0.0 2.0
      vertex 2.0 0.0 2.0
      vertex 2.0 0.0 0.0
    endloop
  endfacet
endsolid Ground_floor
solid Room_top
  facet normal 0 1 0
    outer loop
      vertex 0.0 2.0 2.0
      vertex 0.0 2.0 0.0
      vertex 2.0 2.0 0.0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 0.0 2.0 2.0
      vertex 2.0 2.0 0.0
      vertex 2.0 2.0 2.0
    endloop
  endfacet
endsolid Room_top
