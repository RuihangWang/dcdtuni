    {"id": "mid", "type": "junction", "position_m": [1,0,0]},
    {"id": "return", "type": "pressure_bc", "position_m": [2,0,0], "bc": {"P_Pa": 100000}},
    {"id": "dead_end", "type": "junction", "position_m": [1,1,0]}
