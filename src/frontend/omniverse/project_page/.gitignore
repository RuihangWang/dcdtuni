# 论文全文（SCANO_paper.pdf）与方法架构图。
# 论文正在双盲评审 —— 这个目录永远不进仓库，公开与否都一样。
# 注意：仓库根 .gitattributes 把 *.pdf *.png 都送进 git-lfs，所以误提交不只是
# 泄露，还会占掉 LFS 的免费额度，而且从 LFS 历史里清除比清 git 历史更麻烦。
_withheld/

# 导出产物：两份 PDF（各约 11 MB）、PPTX（12 MB）、三个 GIF（约 10 MB）。
# 全部可由 export_pdf.py / build_ppt.py / make_gifs.py 重新生成。
# 同样受 LFS 规则影响：PDF 与 GIF 都会走 LFS，免费流量只有 1 GB/月，
# 提交它们等于每次 clone 都替所有人多下 45 MB。
export/

__pycache__/
*.pyc
